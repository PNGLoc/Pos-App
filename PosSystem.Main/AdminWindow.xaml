<Window x:Class="PosSystem.Main.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quản trị hệ thống"
       WindowState="Maximized"
    >

    <!-- 1. KHAI BÁO RESOURCES Ở ĐẦU TIÊN -->
    <Window.Resources>
        <!-- Style cho nút Menu -->
        <Style x:Key="AdminMenuButton"
               TargetType="RadioButton">
            <Setter Property="Foreground"
                    Value="LightGray"/>
            <Setter Property="FontSize"
                    Value="16"/>
            <Setter Property="Margin"
                    Value="0,5,0,5"/>
            <Setter Property="Padding"
                    Value="20,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked"
                         Value="True">
                    <Setter Property="Background"
                            Value="#007BFF"/>
                    <Setter Property="Foreground"
                            Value="White"/>
                    <Setter Property="FontWeight"
                            Value="Bold"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- 2. GIAO DIỆN CHÍNH (GRID) Ở DƯỚI -->
    <Grid>
        <Grid.ColumnDefinitions>
           <ColumnDefinition Width="Auto"
                  MinWidth="200"
                  MaxWidth="280"/>
            <!-- Menu trái -->
            <ColumnDefinition Width="*"/>
            <!-- Nội dung phải -->
        </Grid.ColumnDefinitions>

        <!-- Sidebar Menu -->
        <Border Background="#343A40">
            <StackPanel>
                <TextBlock Text="ADMIN PANEL"
                           Foreground="White"
                           FontSize="20"
                           FontWeight="Bold"
                           Margin="20"/>

                <!-- IP Address Display -->
                <Border Background="#555555"
                        Padding="10"
                        Margin="10,0,10,15"
                        CornerRadius="3">
                    <StackPanel>
                        <TextBlock Text="Đường dẫn web điện thoại:"
                                   Foreground="#AAA"
                                   FontSize="12"
                                   Margin="0,0,0,5"/>
                        <TextBlock x:Name="lblIPAddress"
                                   Text="Đang tải..."
                                   Foreground="#00FF00"
                                   FontSize="13"
                                   FontFamily="Courier New"
                                   FontWeight="Bold"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border> <!-- NÚT CHUYỂN SANG BÁN HÀNG -->
                <Button Content="➡ VÀO BÁN HÀNG"
                        Height="45"
                        Background="#28A745"
                        Foreground="White"
                        FontWeight="Bold"
                        FontSize="14"
                        Click="BtnGoToPOS_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius"
                                    Value="5"/>
                        </Style>
                    </Button.Resources>
                </Button>
                    <Separator Background="#555"
                           Margin="10"/>
                <!-- Lúc này StaticResource đã được định nghĩa ở trên nên sẽ không lỗi nữa -->
                <RadioButton Content="🏠 Thống kê"
                             Style="{StaticResource AdminMenuButton}"
                             Click="Menu_Click"
                             Tag="Dashboard"
                             IsChecked="True"/>
                <Separator Background="#555"
                           Margin="5"/>
                <RadioButton Content="🖨 Cấu hình Máy in"
                             Style="{StaticResource AdminMenuButton}"
                             Click="Menu_Click"
                             Tag="Printer"/>
                <RadioButton Content="🏷 Loại bàn" 
                             Style="{StaticResource AdminMenuButton}"
                             Click="Menu_Click" 
                             Tag="TableCategory"/>
                <RadioButton Content="🍽 Quản lý bàn"
                             Style="{StaticResource AdminMenuButton}"
                             Click="Menu_Click"
                             Tag="Table"/>
                <RadioButton Content="👥 Quản lý tài khoản"
                             Style="{StaticResource AdminMenuButton}"
                             Click="Menu_Click"
                             Tag="Account"/>
                <RadioButton Content="👥 Quản lý chấm công"
                             Style="{StaticResource AdminMenuButton}"
                             Click="Menu_Click"
                             Tag="Employee"/>
                <RadioButton Content="📂 Thực đơn / Danh mục"
                             Style="{StaticResource AdminMenuButton}"
                             Click="Menu_Click"
                             Tag="Menu"/>
                <RadioButton Content="💰 Giá lễ / Tết"
                             Style="{StaticResource AdminMenuButton}"
                             Click="Menu_Click"
                             Tag="PriceRule"/>
                <RadioButton Content="📜 Lịch sử đơn hàng"
                             Style="{StaticResource AdminMenuButton}"
                             Click="Menu_Click"
                             Tag="OrderHistory"/>
               
            </StackPanel>
        </Border>

        <!-- Content Area -->
        <Border Grid.Column="1"
                Background="#F4F6F9"
                Padding="20">
            <Frame x:Name="mainFrame"
                   NavigationUIVisibility="Hidden"/>
        </Border>
    </Grid>
</Window>