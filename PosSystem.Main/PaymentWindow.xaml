<Window x:Class="PosSystem.Main.PaymentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thanh toán đơn hàng"
        Height="440"
        Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="White"
        BorderBrush="#28A745"
        BorderThickness="2">

        <Grid Margin="20">
                <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <TextBlock Grid.Row="0"
                           Text="XÁC NHẬN THANH TOÁN"
                           FontSize="24"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Foreground="#333"/>
                <TextBlock Grid.Row="1"
                           x:Name="lblOrderInfo"
                           Text="Bàn 1 - Đơn #102"
                           FontSize="14"
                           HorizontalAlignment="Center"
                           Foreground="#666"
                           Margin="0,5,0,20"/>

                <!-- Tổng tiền -->
                <Border Grid.Row="2"
                        Background="#F8F9FA"
                        Padding="5"
                        CornerRadius="10"
                        Margin="0,0,0,20">
                        <StackPanel>
                                <DockPanel Margin="0,0,0,5">
                                        <TextBlock Text="Tổng tiền hàng:"
                                                   FontSize="16"/>
                                        <TextBlock x:Name="txtSubTotal"
                                                   Text="100.000đ"
                                                   FontSize="16"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Right"/>
                                </DockPanel>
                                <DockPanel Margin="0,0,0,5">
                                        <TextBlock Text="Giảm giá:"
                                                   FontSize="16"
                                                   Foreground="Red"/>
                                        <TextBlock x:Name="txtDiscount"
                                                   Text="-0đ"
                                                   FontSize="16"
                                                   FontWeight="Bold"
                                                   Foreground="Red"
                                                   HorizontalAlignment="Right"/>
                                </DockPanel>
                                <Separator Margin="0,10"/>
                                <DockPanel>
                                        <TextBlock Text="KHÁCH CẦN TRẢ:"
                                                   FontSize="20"
                                                   FontWeight="Bold"/>
                                        <TextBlock x:Name="txtFinal"
                                                   Text="100.000đ"
                                                   FontSize="32"
                                                   FontWeight="Bold"
                                                   Foreground="#28A745"
                                                   HorizontalAlignment="Right"/>
                                </DockPanel>
                        </StackPanel>
                </Border>

                <!-- Phương thức thanh toán -->
                <StackPanel Grid.Row="3">
                        <TextBlock Text="Phương thức:"
                                   FontWeight="Bold"
                                   Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center">
                                <RadioButton x:Name="radCash"
                                             Content="💵 Tiền mặt"
                                             GroupName="PayMethod"
                                             IsChecked="True"
                                             FontSize="16"
                                             Margin="0,0,20,0"
                                             VerticalContentAlignment="Center"/>
                                <RadioButton x:Name="radTransfer"
                                             Content="📱 Chuyển khoản (QR)"
                                             GroupName="PayMethod"
                                             FontSize="16"
                                             VerticalContentAlignment="Center"/>
                        </StackPanel>

                        <!-- Tùy chọn Không In (Style Red + Focus) -->
                        <CheckBox x:Name="chkNoPrint"
                                  Content="🔕 KHÔNG IN HÓA ĐƠN"
                                  FontSize="15"
                                  HorizontalAlignment="Center"
                                  Margin="0,15,0,0"
                                  VerticalContentAlignment="Center"
                                  Foreground="#DC3545">
                            <CheckBox.Style>
                                <Style TargetType="CheckBox">
                                    <Setter Property="FontWeight" Value="Normal"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="CheckBox">
                                                <Border x:Name="bdr" Background="Transparent" Padding="10,5" CornerRadius="5" BorderThickness="1" BorderBrush="Transparent">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Grid Width="20" Height="20" Margin="0,0,10,0">
                                                            <Border BorderBrush="#DC3545" BorderThickness="2" CornerRadius="3" Background="White"/>
                                                            <Path x:Name="checkMark" Data="M 4,10 L 8,14 L 16,6" Stroke="#DC3545" StrokeThickness="2" Visibility="Collapsed"/>
                                                        </Grid>
                                                        <ContentPresenter VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="checkMark" Property="Visibility" Value="Visible"/>
                                                        <Setter TargetName="bdr" Property="Background" Value="#F8D7DA"/>
                                                        <Setter TargetName="bdr" Property="BorderBrush" Value="#DC3545"/>
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bdr" Property="Background" Value="#F8F9FA"/>
                                                    </Trigger>
                                                    <MultiTrigger>
                                                        <MultiTrigger.Conditions>
                                                            <Condition Property="IsChecked" Value="True"/>
                                                            <Condition Property="IsMouseOver" Value="True"/>
                                                        </MultiTrigger.Conditions>
                                                        <Setter TargetName="bdr" Property="Background" Value="#F5C6CB"/>
                                                    </MultiTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </CheckBox.Style>
                        </CheckBox>
                </StackPanel>

                <!-- Buttons -->
                <StackPanel Grid.Row="4"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,20,0,0">
                        <Button Content="🖨 In Tạm Tính"
                                Width="120"
                                Height="45"
                                Background="#17A2B8"
                                Foreground="White"
                                Margin="0,0,10,0"
                                Click="BtnPrintCheck_Click"/>
                        <Button Content="Hủy"
                                Width="100"
                                Height="45"
                                Background="#6C757D"
                                Foreground="White"
                                Margin="0,0,10,0"
                                Click="BtnCancel_Click"/>
                        <Button Content="✅ THANH TOÁN"
                                Width="150"
                                Height="45"
                                Background="#28A745"
                                Foreground="White"
                                FontWeight="Bold"
                                Click="BtnPay_Click"/>
                </StackPanel>
        </Grid>
</Window>