<Window x:Class="PosSystem.Main.PaymentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thanh toán đơn hàng"
        Height="Auto"
        SizeToContent="Height"
        Width="580"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="White"
        BorderBrush="#28A745"
        BorderThickness="2">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="XÁC NHẬN THANH TOÁN"
                       FontSize="22"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Foreground="#333"/>
            <TextBlock x:Name="lblOrderInfo"
                       Text="Bàn 1 - Đơn #102"
                       FontSize="14"
                       HorizontalAlignment="Center"
                       Foreground="#666"
                       Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Main Content: 2 Columns -->
        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: Bill Information -->
            <Border Grid.Column="0"
                    Background="#F8F9FA"
                    Padding="15"
                    CornerRadius="8"
                    BorderBrush="#EEE"
                    BorderThickness="1">
                <StackPanel VerticalAlignment="Center">
                    <!-- New Detailed Breakdown -->
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock Text="Tổng tiền (gốc):"
                                   FontSize="15"
                                   Foreground="#555"/>
                        <TextBlock x:Name="txtOriginalTotal"
                                   Text="100.000đ"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Right"/>
                    </DockPanel>

                    <DockPanel x:Name="pnlItemDiscount" Margin="0,0,0,8" Visibility="Collapsed">
                        <TextBlock Text="Giảm giá món:"
                                   FontSize="15"
                                   Foreground="#DC3545"/>
                        <TextBlock x:Name="txtItemDiscount"
                                   Text="-0đ"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="#DC3545"
                                   HorizontalAlignment="Right"/>
                    </DockPanel>

                    <DockPanel x:Name="pnlBillDiscount" Margin="0,0,0,8" Visibility="Collapsed">
                        <TextBlock Text="Giảm giá HĐ:"
                                   FontSize="15"
                                   Foreground="#DC3545"/>
                        <TextBlock x:Name="txtBillDiscount"
                                   Text="-0đ"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="#DC3545"
                                   HorizontalAlignment="Right"/>
                    </DockPanel>
                    <Separator Margin="0,8"/>
                    <DockPanel>
                        <TextBlock Text="CẦN TRẢ:"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   VerticalAlignment="Bottom"/>
                        <TextBlock x:Name="txtFinal"
                                   Text="100.000đ"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="#28A745"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Bottom"/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- RIGHT: Payment Method -->
            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <!-- Styles -->
                <StackPanel.Resources>
                    <Style x:Key="PaymentOptionStyle" TargetType="RadioButton">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border x:Name="bdr"
                                            CornerRadius="6"
                                            BorderThickness="1"
                                            BorderBrush="#E0E0E0"
                                            Background="White"
                                            Padding="10"
                                            Margin="0,0,0,10"
                                            Cursor="Hand">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <!-- Check Circle -->
                                            <Border Grid.Column="0"
                                                    Width="20" Height="20"
                                                    CornerRadius="10"
                                                    BorderThickness="2"
                                                    BorderBrush="#BBB"
                                                    Margin="0,0,10,0"
                                                    VerticalAlignment="Center">
                                                <Ellipse x:Name="dot"
                                                         Width="10" Height="10"
                                                         Fill="#28A745"
                                                         Visibility="Collapsed"/>
                                            </Border>
                                            
                                            <!-- Content -->
                                            <ContentPresenter Grid.Column="1"
                                                              VerticalAlignment="Center"
                                                              TextBlock.FontSize="15"/>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="bdr" Property="Background" Value="#E8F5E9"/>
                                            <Setter TargetName="bdr" Property="BorderBrush" Value="#28A745"/>
                                            <Setter TargetName="bdr" Property="BorderThickness" Value="2"/>
                                            <Setter TargetName="dot" Property="Visibility" Value="Visible"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bdr" Property="Background" Value="#F8F9FA"/>
                                        </Trigger>
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="IsChecked" Value="True"/>
                                                <Condition Property="IsMouseOver" Value="True"/>
                                            </MultiTrigger.Conditions>
                                            <Setter TargetName="bdr" Property="Background" Value="#D4EDDA"/>
                                        </MultiTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </StackPanel.Resources>

                <TextBlock Text="Phương thức thanh toán:"
                           FontWeight="SemiBold"
                           FontSize="14"
                           Margin="0,0,0,10"/>
                
                <RadioButton x:Name="radCash"
                             Content="💵 Tiền mặt"
                             GroupName="PayMethod"
                             IsChecked="True"
                             Style="{StaticResource PaymentOptionStyle}"/>
                
                <RadioButton x:Name="radTransfer"
                             Content="📱 Chuyển khoản (QR)"
                             GroupName="PayMethod"
                             Style="{StaticResource PaymentOptionStyle}"
                             Margin="0,0,0,15"/>

                <!-- Checkbox No Print -->
                <CheckBox x:Name="chkNoPrint"
                          Content="🔕 KHÔNG IN HÓA ĐƠN"
                          FontSize="13"
                          Foreground="#DC3545"
                          VerticalContentAlignment="Center">
                    <CheckBox.Style>
                        <Style TargetType="CheckBox">
                            <Setter Property="FontWeight" Value="Normal"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="CheckBox">
                                        <Border x:Name="bdr" Background="Transparent" Padding="8,4" CornerRadius="4" BorderThickness="1" BorderBrush="Transparent">
                                            <StackPanel Orientation="Horizontal">
                                                <Grid Width="16" Height="16" Margin="0,0,8,0">
                                                    <Border BorderBrush="#DC3545" BorderThickness="1.5" CornerRadius="3" Background="White"/>
                                                    <Path x:Name="checkMark" Data="M 3,8 L 6,11 L 13,4" Stroke="#DC3545" StrokeThickness="2" Visibility="Collapsed"/>
                                                </Grid>
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="checkMark" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="bdr" Property="Background" Value="#FFF0F1"/>
                                                <Setter TargetName="bdr" Property="BorderBrush" Value="#F5C6CB"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bdr" Property="Background" Value="#F8F9FA"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </CheckBox.Style>
                </CheckBox>
            </StackPanel>
        </Grid>

        <!-- Footer Buttons -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Hủy bỏ"
                    Width="90"
                    Height="40"
                    Background="#6C757D"
                    Foreground="White"
                    Margin="0,0,10,0"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Click="BtnCancel_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="4"/>
                    </Style>
                </Button.Resources>
            </Button>
            <Button Content="✅ THANH TOÁN"
                    Width="140"
                    Height="40"
                    Background="#28A745"
                    Foreground="White"
                    FontWeight="Bold"
                    FontSize="14"
                    Click="BtnPay_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="4"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>