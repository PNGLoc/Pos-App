<UserControl x:Class="PosSystem.Main.Pages.SystemSettingPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="800"
             Background="#F4F6F9">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="White"
                Padding="20,15"
                Margin="0,0,0,15"
                CornerRadius="8">
            <StackPanel>
                <TextBlock Text="CÀI ĐẶT HỆ THỐNG"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="#333"/>
                <TextBlock Text="Tùy chỉnh các thiết lập chung cho hệ thống POS."
                           FontSize="13"
                           Foreground="#666"
                           Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- Content -->
        <Border Grid.Row="1"
                Background="White"
                Padding="20"
                CornerRadius="8">
            <StackPanel>
                <!-- Existing Sound Settings -->
                <TextBlock Text="🔊 Âm thanh thông báo" FontWeight="Bold" Margin="0,0,0,10"/>
                
                <CheckBox x:Name="chkEnableSound"
                          Content="Bật âm thanh thông báo"
                          FontSize="14"
                          FontWeight="SemiBold"
                          Margin="0,0,0,15"
                          Checked="ChkEnableSound_Checked"
                          Unchecked="ChkEnableSound_Unchecked"/>

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="Âm lượng:"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"
                               FontWeight="SemiBold"/>
                    <Slider x:Name="sldVolume"
                            Minimum="0"
                            Maximum="100"
                            Width="260"
                            ValueChanged="SldVolume_ValueChanged"
                            Thumb.DragCompleted="SldVolume_DragCompleted"/>
                    <TextBlock x:Name="lblVolume"
                               Margin="10,0,10,0"
                               MinWidth="35"
                               VerticalAlignment="Center"
                               Foreground="#555"/>
                    <Button Content="Nghe thử"
                            Width="80"
                            Height="30"
                            Margin="0,0,10,0"
                            Background="#6C757D"
                            Foreground="White"
                            FontWeight="Bold"
                            Click="BtnTest_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button Content="Chọn file..."
                            Width="80"
                            Height="30"
                            Background="#17A2B8" 
                            Foreground="White"
                            FontWeight="Bold"
                            Click="BtnUpload_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>

                <!-- New Section for General Settings -->
                <Separator Margin="0,20" Background="#EEE"/>
                <TextBlock Text="⚙️ Cài đặt chung" FontWeight="Bold" Margin="0,0,0,10"/>

                <CheckBox x:Name="chkAutoReturnPay"
                          Content="Tự động quay về sau khi Thanh toán"
                          FontSize="14"
                          FontWeight="SemiBold"
                          Margin="0,0,0,10"
                          Checked="AutoSave_Changed"
                          Unchecked="AutoSave_Changed"/>

                <CheckBox x:Name="chkAutoReturnProvisional"
                          Content="Tự động quay về sau khi In tạm tính"
                          FontSize="14"
                          FontWeight="SemiBold"
                          Margin="0,0,0,10"
                          Checked="AutoSave_Changed"
                          Unchecked="AutoSave_Changed"/>

                <CheckBox x:Name="chkAutoReturnKitchen"
                          Content="Tự động quay về sau khi Gửi bếp"
                          FontSize="14"
                          FontWeight="SemiBold"
                          Margin="0,0,0,15"
                          Checked="AutoSave_Changed"
                          Unchecked="AutoSave_Changed"/>

                <StackPanel Orientation="Horizontal"
                            Margin="0,20,0,0"
                            HorizontalAlignment="Right"
                            Visibility="Collapsed">
                    <Button Content="Lưu lại"
                            Width="120"
                            Height="35"
                            Background="#007BFF"
                            Foreground="White"
                            FontWeight="Bold"
                            Click="BtnSave_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius"
                                        Value="5"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
