<UserControl x:Class="PosSystem.Main.Pages.LayoutDesignerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="#F4F6F9"
             d:DesignHeight="700"
             d:DesignWidth="1200">

    <UserControl.Resources>
        <!-- Card Style -->
        <DropShadowEffect x:Key="CardShadow" Color="Black" BlurRadius="20" ShadowDepth="5" Opacity="0.1"/>
        
        <Style TargetType="Border" x:Key="CardBorder">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
        </Style>

        <!-- Toolbox Button Style -->
        <Style x:Key="ToolboxBtnStyle" TargetType="Button">
            <Setter Property="Height" Value="45"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DEE2E6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#495057"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6">
                            <ContentPresenter VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E9ECEF"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#ADB5BD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ListBox Item Style -->
        <Style x:Key="PreviewItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="4" 
                                Padding="8,4">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#007BFF"/>
                                <Setter TargetName="bd" Property="Background" Value="#E7F3FF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F8F9FA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" /> <!-- Toolbox -->
            <ColumnDefinition Width="*" />   <!-- Preview -->
            <ColumnDefinition Width="320" /> <!-- Properties -->
        </Grid.ColumnDefinitions>

        <!-- COLUMN 1: TOOLBOX -->
        <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,20,0">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <StackPanel Margin="0,0,0,20">
                    <TextBlock x:Name="txtTitle" Text="🛠 KHO GIAO DIỆN" FontSize="18" FontWeight="Bold" Foreground="#343A40"/>
                    <TextBlock Text="Chọn thành phần để thêm vào mẫu in" FontSize="13" Foreground="#868E96" Margin="0,5,0,0"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
                    <StackPanel x:Name="pnlToolbox">
                        <!-- GROUP: COMMON (Used in both Bill & Kitchen) -->
                        <TextBlock Text="CHUNG (BILL &amp; BẾP)" FontWeight="Bold" Foreground="#ADB5BD" FontSize="12" Margin="0,0,0,10"/>
                        <Button Content="📝 Văn bản tùy ý" Tag="Text" Click="BtnToolbox_Click" Style="{StaticResource ToolboxBtnStyle}"/>
                        <Button Content="➖ Đường kẻ ngang" Tag="Separator" Click="BtnToolbox_Click" Style="{StaticResource ToolboxBtnStyle}"/>
                        <Button Content="➗ Đường kẻ nét đứt" Tag="SeparatorDashed" Click="BtnToolbox_Click" Style="{StaticResource ToolboxBtnStyle}"/>
                        <Button Content="🖼️ Logo / Hình ảnh" Tag="Logo" Click="BtnToolbox_Click" Style="{StaticResource ToolboxBtnStyle}"/>
                        <Button Content="🆔 Mã hóa đơn: {OrderId}" Tag="TextOrderId" Click="BtnToolbox_Click" Style="{StaticResource ToolboxBtnStyle}"/>
                        <Button Content="📍 Tên bàn: {Table}" Tag="TextTable" Click="BtnToolbox_Click" Style="{StaticResource ToolboxBtnStyle}"/>
                        <Button Content="🕒 Giờ in: {PrintTime}" Tag="TextPrintTime" Click="BtnToolbox_Click" Style="{StaticResource ToolboxBtnStyle}"/>

                        <!-- GROUP: BILL SPECIFIC -->
                        <StackPanel x:Name="grpBill" Visibility="Visible">
                            <TextBlock Text="CHO HÓA ĐƠN (BILL)" FontWeight="Bold" Foreground="#ADB5BD" FontSize="12" Margin="0,15,0,10"/>
                            <Button Content="👤 Thu ngân/NV: {Staff}" Tag="TextStaff" Click="BtnToolbox_Click" Style="{StaticResource ToolboxBtnStyle}"/>
                            <Button Content="🕒 Giờ đến &amp; Giờ in" Tag="TextTime" Click="BtnToolbox_Click" Style="{StaticResource ToolboxBtnStyle}"/>
                            <Button Content="⏳ Thời gian ngồi" Tag="TextDuration" Click="BtnToolbox_Click" Style="{StaticResource ToolboxBtnStyle}"/>
                            <Button Content="📋 Danh sách món (Bill)" Tag="OrderDetails" Click="BtnToolbox_Click" Style="{StaticResource ToolboxBtnStyle}" Background="#D1E7DD" BorderBrush="#BADBCC"/>
                            <Button Content="💰 Tổng tiền thanh toán" Tag="Total" Click="BtnToolbox_Click" Style="{StaticResource ToolboxBtnStyle}" Background="#D1E7DD" BorderBrush="#BADBCC"/>
                            <Button Content="⬛ Mã QR Chuyển khoản" Tag="QRCode" Click="BtnToolbox_Click" Style="{StaticResource ToolboxBtnStyle}"/>
                        </StackPanel>

                        <!-- GROUP: KITCHEN SPECIFIC -->
                        <StackPanel x:Name="grpKitchen" Visibility="Collapsed">
                            <TextBlock Text="CHO BẾP / BAR" FontWeight="Bold" Foreground="#ADB5BD" FontSize="12" Margin="0,15,0,10"/>
                            <Button Content="👨‍🍳 Người gửi bếp: {Sender}" Tag="TextSender" Click="BtnToolbox_Click" Style="{StaticResource ToolboxBtnStyle}"/>
                            <Button Content="🔔 Số đợt gọi: {Batch}" Tag="BatchNumber" Click="BtnToolbox_Click" Style="{StaticResource ToolboxBtnStyle}"/>
                            <Button Content="🥘 Danh sách món (Bếp)" Tag="KitchenOrderDetails" Click="BtnToolbox_Click" Style="{StaticResource ToolboxBtnStyle}" Background="#FFF3CD" BorderBrush="#FFECB5"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- COLUMN 2: PREVIEW -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Toolbar -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,15">
                <Button Content="⬆ Lên" Click="BtnUp_Click" Width="80" Height="35" Margin="5" Background="White" BorderBrush="#DEE2E6" BorderThickness="1"/>
                <Button Content="⬇ Xuống" Click="BtnDown_Click" Width="80" Height="35" Margin="5" Background="White" BorderBrush="#DEE2E6" BorderThickness="1"/>
                <Button Content="🗑 Xóa" Click="BtnDelete_Click" Width="80" Height="35" Margin="5" Background="#FFE3E3" Foreground="#DC3545" BorderThickness="0"/>
            </StackPanel>

            <!-- Paper Representation -->
            <Border Grid.Row="1" Background="#505050" CornerRadius="8" Padding="20">
                <Border Background="White" Width="380" VerticalAlignment="Stretch" Effect="{StaticResource CardShadow}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Header Placeholder -->
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/> <!-- Cutter Placeholder -->
                        </Grid.RowDefinitions>

                        <!-- Content List -->
                        <ListBox x:Name="lstElements" Grid.Row="1"
                                 SelectionChanged="LstElements_SelectionChanged"
                                 ItemContainerStyle="{StaticResource PreviewItemStyle}"
                                 BorderThickness="0" Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 Padding="15">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <!-- Text Preview -->
                                        <TextBlock Text="{Binding DisplayPreview}" 
                                                   FontSize="{Binding FontSize}" 
                                                   FontWeight="{Binding FontWeightDisplay}" 
                                                   TextAlignment="{Binding TextAlignmentDisplay}"
                                                   TextWrapping="Wrap"
                                                   Visibility="{Binding IsTextVisible}"
                                                   Foreground="Black"/>
                                        
                                        <!-- Separator Preview -->
                                        <Border BorderBrush="Black" BorderThickness="0,0,0,1" Height="1" 
                                                Visibility="{Binding IsSeparatorVisible}" 
                                                SnapsToDevicePixels="True"/>

                                        <!-- Separator Dashed Preview -->
                                        <Rectangle Height="1" Stroke="Black" StrokeThickness="1" StrokeDashArray="4 2" 
                                                   Visibility="{Binding IsDashedSeparatorVisible}" 
                                                   SnapsToDevicePixels="True"/>

                                        <!-- Image/Logo Preview -->
                                        <Border Background="#F1F3F5" Height="80" Width="80" 
                                                HorizontalAlignment="{Binding HorizontalAlignDisplay}"
                                                Visibility="{Binding IsImageVisible}"
                                                CornerRadius="4">
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <TextBlock Text="🖼" FontSize="24" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Border>

            <!-- Save Button -->
            <Button Grid.Row="2" Content="💾 LƯU MẪU IN" Click="BtnSave_Click" 
                    Height="45" Width="200" Margin="0,20,0,0"
                    Background="#28A745" Foreground="White" FontWeight="Bold" FontSize="15"
                    BorderThickness="0">
                <Button.Resources>
                    <Style TargetType="Border"> <Setter Property="CornerRadius" Value="25"/> </Style>
                </Button.Resources>
            </Button>
        </Grid>

        <!-- COLUMN 3: PROPERTIES -->
        <Border Grid.Column="2" Style="{StaticResource CardBorder}" Margin="20,0,0,0">
            <Grid x:Name="pnlProperties" IsEnabled="False" Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Margin="0,0,0,20">
                    <TextBlock Text="⚙ TÙY CHỈNH" FontSize="18" FontWeight="Bold" Foreground="#343A40"/>
                    <TextBlock x:Name="lblSelectedType" Text="Chưa chọn thành phần" FontSize="13" Foreground="#007BFF" Margin="0,5,0,0" FontWeight="SemiBold"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- ALIGNMENT PROP (Shared) -->
                        <StackPanel x:Name="pnlAlignProp" Visibility="Collapsed" Margin="0,0,0,15">
                            <TextBlock Text="Căn lề:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <ComboBox x:Name="cboAlign" SelectionChanged="Prop_Changed" Padding="5" Height="30">
                                <ComboBoxItem Content="Left (Trái)"/>
                                <ComboBoxItem Content="Center (Giữa)"/>
                                <ComboBoxItem Content="Right (Phải)"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- TEXT PROPERTIES -->
                        <StackPanel x:Name="pnlTextProp" Visibility="Visible">
                            <TextBlock Text="Nội dung:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <TextBox x:Name="txtContent" Height="60" TextWrapping="Wrap" Padding="5" 
                                     TextChanged="TxtContent_TextChanged" BorderBrush="#CED4DA"/>

                            <StackPanel Margin="0,10,0,0">
                                <TextBlock Text="Cỡ chữ:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                <TextBox x:Name="txtFontSize" TextChanged="Prop_Changed" Height="30" Padding="5" VerticalContentAlignment="Center"/>
                            </StackPanel>
                            
                            <CheckBox x:Name="chkBold" Content="In đậm (Bold)" Margin="0,15,0,0" Checked="Prop_Changed" Unchecked="Prop_Changed"/>
                        </StackPanel>

                        <!-- ADVANCED OPTIONS (LISTS/TOTALS) -->
                        <StackPanel x:Name="pnlOptionProp" Visibility="Collapsed" Margin="0,20,0,0">
                            <TextBlock Text="CÀI ĐẶT NÂNG CAO" FontWeight="Bold" Foreground="#6C757D" Margin="0,0,0,10"/>
                            
                            <StackPanel x:Name="optOrderDetails">
                                <CheckBox x:Name="chkShowNote" Content="Hiển thị Ghi chú món" Margin="0,5" Checked="Prop_Changed" Unchecked="Prop_Changed"/>
                                <CheckBox x:Name="chkOrderDetailsBold" Content="In đậm tên món" Margin="0,5" Checked="Prop_Changed" Unchecked="Prop_Changed"/>
                                
                                <!-- NEW: KẺ NGĂN CÁCH -->
                                <CheckBox x:Name="chkItemSep" Content="Kẻ ngăn các món" Margin="0,10,0,5" Checked="Prop_Changed" Unchecked="Prop_Changed" FontWeight="SemiBold"/>
                                <Grid Margin="0,0,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Kiểu kẻ:" VerticalAlignment="Center" Margin="20,0,10,0"/>
                                    <ComboBox x:Name="cboItemSepStyle" Grid.Column="1" SelectionChanged="Prop_Changed" Height="28" Padding="5">
                                        <ComboBoxItem Content="Nét liền (Solid)"/>
                                        <ComboBoxItem Content="Nét đứt (Dashed)"/>
                                    </ComboBox>
                                </Grid>

                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="1.5*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Cỡ chữ Header:" VerticalAlignment="Center"/>
                                    <TextBox x:Name="txtHeaderSize" Grid.Column="1" Height="28" Padding="3" TextChanged="TxtContent_TextChanged"/>
                                </Grid>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="1.5*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Cỡ chữ Món:" VerticalAlignment="Center"/>
                                    <TextBox x:Name="txtItemSize" Grid.Column="1" Height="28" Padding="3" TextChanged="TxtContent_TextChanged"/>
                                </Grid>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="1.5*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Cỡ chữ Ghi chú:" VerticalAlignment="Center"/>
                                    <TextBox x:Name="txtNoteSize" Grid.Column="1" Height="28" Padding="3" TextChanged="TxtContent_TextChanged"/>
                                </Grid>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="1.5*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Khoảng cách cột:" VerticalAlignment="Center"/>
                                    <TextBox x:Name="txtColumnSpacing" Grid.Column="1" Height="28" Padding="3" TextChanged="TxtContent_TextChanged"/>
                                </Grid>
                            </StackPanel>

                            <StackPanel x:Name="optTotal">
                                <CheckBox x:Name="chkShowSubTotal" Content="Hiện Tạm tính" Margin="0,5" Checked="Prop_Changed" Unchecked="Prop_Changed"/>
                                <CheckBox x:Name="chkShowDiscount" Content="Hiện Giảm giá/Thuế" Margin="0,5" Checked="Prop_Changed" Unchecked="Prop_Changed"/>
                                <CheckBox x:Name="chkTotalBold" Content="In đậm Tổng cộng" Margin="0,5" Checked="Prop_Changed" Unchecked="Prop_Changed"/>
                                
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="1.5*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Cỡ chữ Tổng:" VerticalAlignment="Center"/>
                                    <TextBox x:Name="txtTotalHeaderSize" Grid.Column="1" Height="28" Padding="3" TextChanged="TxtContent_TextChanged"/>
                                </Grid>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="1.5*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Cỡ chữ Phụ:" VerticalAlignment="Center"/>
                                    <TextBox x:Name="txtSubSize" Grid.Column="1" Height="28" Padding="3" TextChanged="TxtContent_TextChanged"/>
                                </Grid>
                            </StackPanel>
                        </StackPanel>

                        <!-- IMAGE PROPERTIES -->
                        <StackPanel x:Name="pnlImageProp" Visibility="Collapsed" Margin="0,10,0,0">
                            <Button Content="📂 Chọn ảnh từ máy..." Click="BtnUploadImage_Click" Padding="10,8" Background="#E9ECEF" BorderThickness="0" Margin="0,0,0,15"/>
                            <Image x:Name="imgPreview" Height="100" Stretch="Uniform" Margin="0,0,0,10"/>
                            
                            <TextBlock Text="Chiều cao ảnh (px):" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <TextBox x:Name="txtImageHeight" Text="300" Height="30" Padding="5" PreviewTextInput="NumberValidationTextBox" TextChanged="Prop_Changed"/>

                            <StackPanel x:Name="pnlQrText" Visibility="Visible" Margin="0,15,0,0">
                                <!-- TOP TEXT -->
                                <TextBlock Text="Chữ trên QR:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                <TextBox x:Name="txtQrTop" Height="30" Padding="5" TextChanged="TxtContent_TextChanged"/>
                                <Grid Margin="0,5,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Cỡ chữ:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBox x:Name="txtQrTopSize" Grid.Column="1" Height="30" Padding="5" ToolTip="Cỡ chữ" Text="12" PreviewTextInput="NumberValidationTextBox" TextChanged="Prop_Changed"/>
                                    <CheckBox x:Name="chkQrTopBold" Grid.Column="2" Content="In đậm" FontWeight="Bold" Margin="15,0,0,0" VerticalAlignment="Center" Checked="Prop_Changed" Unchecked="Prop_Changed"/>
                                </Grid>
                                
                                <!-- BOTTOM TEXT -->
                                <TextBlock Text="Chữ dưới QR:" FontWeight="SemiBold" Margin="0,15,0,5"/>
                                <TextBox x:Name="txtQrBottom" Height="30" Padding="5" TextChanged="TxtContent_TextChanged"/>
                                <Grid Margin="0,5,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Cỡ chữ:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBox x:Name="txtQrBottomSize" Grid.Column="1" Height="30" Padding="5" ToolTip="Cỡ chữ" Text="12" PreviewTextInput="NumberValidationTextBox" TextChanged="Prop_Changed"/>
                                    <CheckBox x:Name="chkQrBottomBold" Grid.Column="2" Content="In đậm" FontWeight="Bold" Margin="15,0,0,0" VerticalAlignment="Center" Checked="Prop_Changed" Unchecked="Prop_Changed"/>
                                </Grid>
                            </StackPanel>
                        </StackPanel>

                        <Separator Margin="0,20"/>
                        <CheckBox x:Name="chkVisible" Content="Hiển thị thành phần này" IsChecked="True" Checked="Prop_Changed" Unchecked="Prop_Changed" FontWeight="SemiBold"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>