<UserControl x:Class="PosSystem.Main.Pages.EmployeeSetupPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="950"
             Background="White">

    <Grid>

        <TabControl Margin="10">
            <TabItem Header="👥 QUẢN LÝ NHÂN SỰ"
                     FontSize="14"
                     FontWeight="Bold"
                     Height="40">
                <DockPanel Margin="0,15,0,0">
                    <StackPanel DockPanel.Dock="Top"
                                Orientation="Horizontal"
                                Margin="0,0,0,15">
                        <TextBlock Text="DANH SÁCH NHÂN VIÊN"
                                   VerticalAlignment="Center"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#333"
                                   Margin="0,0,20,0"/>

                        <Button Content="+ THÊM NHÂN VIÊN"
                                Click="BtnAddNew_Click"
                                Height="35"
                                Padding="15,0"
                                Background="#28A745"
                                Foreground="White"
                                FontWeight="Bold"
                                BorderThickness="0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius"
                                            Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>

                    <DataGrid x:Name="dgEmp"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              BorderThickness="1"
                              BorderBrush="#DDD"
                              RowHeight="40"
                              GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID"
                                                Binding="{Binding EmpID}"
                                                Width="50"/>
                            <DataGridTextColumn Header="Họ tên"
                                                Binding="{Binding FullName}"
                                                Width="*"
                                                FontWeight="SemiBold"/>
                            <DataGridTextColumn Header="Chức vụ"
                                                Binding="{Binding Position}"
                                                Width="120"/>

                            <DataGridTextColumn Header="Mã Thẻ"
                                                Binding="{Binding CardNumber}"
                                                Width="110"/>
                            <DataGridCheckBoxColumn Header="Active"
                                                    Binding="{Binding IsActive}"
                                                    Width="60"/>

                            <DataGridTemplateColumn Header="Thao tác"
                                                    Width="160">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Center">
                                            <Button Content="✏️ Sửa"
                                                    Click="BtnEditRow_Click"
                                                    Tag="{Binding}"
                                                    Width="60"
                                                    Height="28"
                                                    Margin="0,0,8,0"
                                                    Background="#FFC107"
                                                    BorderThickness="0"/>
                                            <Button Content="🗑️ Xóa"
                                                    Click="BtnDeleteRow_Click"
                                                    Tag="{Binding}"
                                                    Width="60"
                                                    Height="28"
                                                    Background="#DC3545"
                                                    Foreground="White"
                                                    BorderThickness="0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="📅 LỊCH SỬ CHẤM CÔNG"
                     FontSize="14"
                     FontWeight="Bold"
                     Height="40">
                <Grid Margin="0,15,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0"
                            Background="#F0F2F5"
                            Padding="10"
                            CornerRadius="5"
                            Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <TextBlock Text="Từ:"
                                       VerticalAlignment="Center"
                                       Margin="0,0,5,0"/>
                            <DatePicker x:Name="dpFrom"
                                        Width="110"
                                        SelectedDateChanged="OnFilterChanged"/>
                            <TextBlock Text="Đến:"
                                       VerticalAlignment="Center"
                                       Margin="15,0,5,0"/>
                            <DatePicker x:Name="dpTo"
                                        Width="110"
                                        SelectedDateChanged="OnFilterChanged"/>
                            <TextBlock Text="NV:"
                                       VerticalAlignment="Center"
                                       Margin="15,0,5,0"/>
                            <ComboBox x:Name="cboEmpFilter"
                                      Width="150"
                                      DisplayMemberPath="FullName"
                                      SelectedValuePath="EmpID"
                                      SelectionChanged="OnFilterChanged"/>
                        </StackPanel>
                    </Border>
                    <DataGrid x:Name="dgTimeLogs"
                              Grid.Row="1"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              BorderThickness="1"
                              BorderBrush="#DDD"
                              RowHeight="30">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID"
                                                Binding="{Binding LogID}"
                                                Width="50"/>
                            <DataGridTextColumn Header="Nhân viên"
                                                Binding="{Binding Employee.FullName}"
                                                Width="200"
                                                FontWeight="SemiBold"/>
                            <DataGridTextColumn Header="Ngày"
                                                Binding="{Binding CheckInTime, StringFormat=dd/MM/yyyy}"
                                                Width="100"/>
                            <DataGridTextColumn Header="Giờ Vào"
                                                Binding="{Binding CheckInTime, StringFormat=HH:mm:ss}"
                                                Width="100"
                                                Foreground="Green"/>
                            <DataGridTextColumn Header="Giờ Ra"
                                                Binding="{Binding CheckOutTime, StringFormat=HH:mm:ss, TargetNullValue='--:--'}"
                                                Width="100"
                                                Foreground="Red"/>
                            <DataGridTextColumn Header="Thời lượng"
                                                Binding="{Binding DurationDisplay}"
                                                Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="📊 THỐNG KÊ GIỜ LÀM"
                     FontSize="14"
                     FontWeight="Bold"
                     Height="40">
                <Grid Margin="0,15,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="#F0F2F5"
                            Padding="10"
                            CornerRadius="5"
                            Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <TextBlock Text="Thống kê từ:"
                                       VerticalAlignment="Center"
                                       Margin="0,0,5,0"/>

                            <DatePicker x:Name="dpStatFrom"
                                        Width="110"
                                        SelectedDateChanged="OnStatFilterChanged"/>

                            <TextBlock Text="Đến:"
                                       VerticalAlignment="Center"
                                       Margin="15,0,5,0"/>

                            <DatePicker x:Name="dpStatTo"
                                        Width="110"
                                        SelectedDateChanged="OnStatFilterChanged"/>

                            <Button Content="📥 Xuất Báo Cáo (Excel)"
                                    Click="BtnExportReport_Click"
                                    Width="160"
                                    Height="30"
                                    Margin="20,0,0,0"
                                    Background="#6610F2"
                                    Foreground="White"
                                    FontWeight="Bold"
                                    BorderThickness="0"/>
                        </StackPanel>
                    </Border>

                    <DataGrid x:Name="dgStats"
                              Grid.Row="1"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              BorderThickness="1"
                              BorderBrush="#DDD"
                              RowHeight="35"
                              GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nhân viên"
                                                Binding="{Binding EmpName}"
                                                Width="200"
                                                FontWeight="Bold"/>
                            <DataGridTextColumn Header="Chức vụ"
                                                Binding="{Binding Position}"
                                                Width="150"/>
                            <DataGridTextColumn Header="Tổng số ca"
                                                Binding="{Binding TotalShifts}"
                                                Width="100"/>

                            <DataGridTextColumn Header="Tổng thời gian"
                                                Binding="{Binding TotalHoursDisplay}"
                                                Width="*"
                                                FontWeight="Bold"
                                                Foreground="#007BFF"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>

        <Grid x:Name="modalOverlay"
              Visibility="Collapsed">
            <Border Background="#AA000000"
                    MouseDown="BtnCloseModal_Click"/>

            <Border Background="White"
                    Width="450"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    CornerRadius="8"
                    Padding="20">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20"
                                      ShadowDepth="0"
                                      Opacity="0.4"/>
                </Border.Effect>

                <StackPanel>
                    <TextBlock x:Name="lblModalTitle"
                               Text="THÊM NHÂN VIÊN MỚI"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#007BFF"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,20"/>

                    <TextBlock Text="Họ và tên (*):"
                               FontWeight="SemiBold"/>
                    <TextBox x:Name="txtName"
                             Height="35"
                             Margin="0,5,0,15"
                             Padding="5,0"
                             VerticalContentAlignment="Center"/>

                    <TextBlock Text="Chức vụ:"
                               FontWeight="SemiBold"/>
                    <TextBox x:Name="txtPos"
                             Height="35"
                             Margin="0,5,0,15"
                             Padding="5,0"
                             VerticalContentAlignment="Center"/>



                    <TextBlock Text="MÃ THẺ RFID:"
                               FontWeight="Bold"
                               Foreground="Blue"/>
                    <TextBox x:Name="txtCard"
                             Height="40"
                             Margin="0,5,0,5"
                             BorderBrush="Blue"
                             BorderThickness="1"
                             VerticalContentAlignment="Center"
                             FontWeight="Bold"
                             FontSize="14"
                             Padding="5,0"
                             ToolTip="Quét thẻ để nhập tự động"/>
                    <TextBlock Text="(Đặt trỏ chuột và quét thẻ)"
                               FontSize="11"
                               Foreground="Gray"
                               FontStyle="Italic"
                               Margin="0,0,0,20"/>

                    <CheckBox x:Name="chkActive"
                              Content="Đang làm việc (Active)"
                              IsChecked="True"
                              FontSize="14"
                              Margin="0,0,0,25"/>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button Content="Hủy bỏ"
                                Click="BtnCloseModal_Click"
                                Width="100"
                                Height="35"
                                Margin="0,0,10,0"
                                Background="#F0F0F0"
                                Foreground="Black"
                                BorderThickness="0"/>
                        <Button Content="💾 LƯU LẠI"
                                Click="BtnSaveModal_Click"
                                Width="120"
                                Height="35"
                                Background="#007BFF"
                                Foreground="White"
                                FontWeight="Bold"
                                BorderThickness="0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</UserControl>