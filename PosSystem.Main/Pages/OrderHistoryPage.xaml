<Page x:Class="PosSystem.Main.Pages.OrderHistoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Lịch sử đơn hàng"
        Background="#F0F2F5">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="White"
                CornerRadius="8"
                Padding="15,10"
                Margin="0,0,0,15">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270" Color="#CCCCCC" Opacity="0.3"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Date Range -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock Text="📅 Từ ngày:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,5,0" Foreground="#495057"/>
                    <DatePicker x:Name="dpFrom" Width="120" SelectedDateChanged="Filter_Changed" Padding="5"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock Text="Đến ngày:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,5,0" Foreground="#495057"/>
                    <DatePicker x:Name="dpTo" Width="120" SelectedDateChanged="Filter_Changed" Padding="5"/>
                </StackPanel>

                <!-- Payment Method Filter -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock Text="💳 PTTT:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,5,0" Foreground="#495057"/>
                    <ComboBox x:Name="cboPaymentMethod" Width="140" SelectionChanged="Filter_Changed" Padding="5" VerticalContentAlignment="Center">
                        <ComboBoxItem Content="Tất cả"/>
                        <ComboBoxItem Content="Tiền mặt" Tag="Cash"/>
                        <ComboBoxItem Content="Chuyển khoản (QR)" Tag="Transfer"/>
                    </ComboBox>
                </StackPanel>
                
                <!-- Delete All Button -->
                <Button Grid.Column="4"
                        Content="🗑️ XÓA TẤT CẢ"
                        Click="BtnDeleteAll_Click"
                        Padding="15,8"
                        Background="#DC3545"
                        Foreground="White"
                        FontWeight="Bold"
                        BorderThickness="0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="5"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Border>

        <DataGrid Grid.Row="1"
                x:Name="dgOrders"
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                IsReadOnly="True"
                  Background="White"
                RowHeight="40"
                SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID"
                        Binding="{Binding OrderID}"
                        Width="60"/>
                <DataGridTextColumn Header="Bàn"
                        Binding="{Binding TableName}"
                        Width="100"/>
                <DataGridTextColumn Header="Thời gian"
                        Binding="{Binding OrderTime, StringFormat='dd/MM/yyyy HH:mm'}"
                        Width="140"/>

                <DataGridTextColumn Header="PTTT"
                        Binding="{Binding PaymentMethodDisplay}"
                        Width="100"/>

                <DataGridTextColumn Header="Tổng tiền"
                        Binding="{Binding FinalAmount, StringFormat={}{0:N0}}"
                        Width="120"
                        FontWeight="Bold"/>
                <DataGridTextColumn Header="Trạng thái"
                        Binding="{Binding StatusDisplay}"
                        Width="100"/>

                <DataGridTemplateColumn Header="Hành động"
                        Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="👁 Chi tiết"
                                        Click="BtnDetail_Click"
                                        Tag="{Binding OrderID}"
                                        Margin="0,0,10,0"
                                        Padding="5,0"/>
                                <Button Content="🗑 Xóa"
                                        Click="BtnDelete_Click"
                                        Tag="{Binding OrderID}"
                                        Background="#6C757D"
                                        Foreground="White"
                                        Padding="5,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Margin="0,10,0,0">
            <TextBlock Text="Tổng doanh thu: "
                    FontSize="16"/>
            <TextBlock x:Name="lblTotalRevenue"
                    Text="0đ"
                    FontSize="18"
                    FontWeight="Bold"
                    Foreground="#28A745"/>
        </StackPanel>
    </Grid>
</Page>