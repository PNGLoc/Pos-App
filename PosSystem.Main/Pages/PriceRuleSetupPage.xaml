<UserControl x:Class="PosSystem.Main.Pages.PriceRuleSetupPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER: ÁP DỤNG GIÁ -->
        <Border Grid.Row="0" Background="#F8F9FA" Padding="15" BorderThickness="0,0,0,1" BorderBrush="#DEE2E6">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🎯 ÁP DỤNG LOẠI GIÁ:" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" Margin="0,0,15,0" Foreground="#333"/>
                    <ComboBox x:Name="cboActiveRule" Width="220" Height="35" VerticalContentAlignment="Center"
                              SelectionChanged="CboActiveRule_SelectionChanged" BorderBrush="#CED4DA"/>
                </StackPanel>

                <Button Content="➕ THÊM LOẠI GIÁ"
                        Click="BtnShowAddForm_Click"
                        DockPanel.Dock="Right"
                        Padding="15,8"
                        Background="#28A745"
                        Foreground="White"
                        FontWeight="Bold"
                        FontSize="13"
                        BorderThickness="0"
                        Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </DockPanel>
        </Border>

        <!-- CONTENT: LIST -->
        <Grid Grid.Row="1" Margin="15">
            <DataGrid x:Name="dgRuleTypes"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      Background="White"
                      RowHeight="45"
                      BorderThickness="1"
                      BorderBrush="#DEE2E6"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      SelectionChanged="dgRuleTypes_SelectionChanged">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F8F9FA"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Padding" Value="10,12"/>
                        <Setter Property="BorderBrush" Value="#DEE2E6"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="10,0"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="BorderThickness" Value="0"/>
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Tên Loại Giá" Binding="{Binding RuleType}" Width="*" FontWeight="SemiBold"/>
                    <DataGridTextColumn Header="Số Sản Phẩm" Binding="{Binding ProductCount}" Width="120" IsReadOnly="True"/>
                    
                    <DataGridTemplateColumn Header="Hành động" Width="200">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="📄 Chi tiết"
                                            Click="BtnEditRuleType_Click"
                                            Width="80" Height="30" Margin="0,0,8,0"
                                            Background="#17A2B8" Foreground="White" BorderThickness="0" Cursor="Hand">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="3"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                    <Button Content="🗑️ Xóa"
                                            Click="BtnDeleteRuleType_Click"
                                            Width="60" Height="30"
                                            Background="#DC3545" Foreground="White" BorderThickness="0" Cursor="Hand">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="3"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- ADD MODAL OVERLAY -->
        <Grid x:Name="modalAddRule" Grid.RowSpan="2" Visibility="Collapsed">
            <Border Background="#99000000" MouseDown="BtnCancelAddForm_Click"/>
            <Border Background="White" Width="400" VerticalAlignment="Center" HorizontalAlignment="Center"
                    CornerRadius="8" Padding="25">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.3"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="THÊM MỚI LOẠI GIÁ" FontSize="18" FontWeight="Bold" 
                               HorizontalAlignment="Center" Margin="0,0,0,20" Foreground="#28A745"/>

                    <TextBlock Text="Tên Loại Giá (ví dụ: holiday, vip, event):" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtRuleType" Height="35" Margin="0,0,0,15" Padding="5,0" VerticalContentAlignment="Center" BorderBrush="#CED4DA"/>

                    <CheckBox x:Name="chkRuleTypeActive" Content="Kích hoạt ngay" IsChecked="True" FontWeight="SemiBold" Margin="0,0,0,20"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Hủy bỏ" Click="BtnCancelAddForm_Click" Width="100" Height="35" Margin="0,0,10,0"
                                Background="#F1F3F5" Foreground="Black" BorderThickness="0" FontWeight="SemiBold" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Button Content="💾 Lưu lại" Click="BtnAddRuleType_Click" Width="120" Height="35"
                                Background="#28A745" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- DETAILS OVERLAY (FULL SCREEN) -->
        <Grid x:Name="DetailPanel" Grid.RowSpan="2" Visibility="Collapsed" Background="White">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Detail Header -->
            <Border Grid.Row="0" Background="#F8F9FA" Padding="15" BorderThickness="0,0,0,1" BorderBrush="#DEE2E6">
                <!-- [MODIFIED] LastChildFill="False" to keep button right-aligned without stretching -->
                <DockPanel LastChildFill="False">
                    <Button DockPanel.Dock="Left" Content="⬅️ Quay lại" Click="BtnBackToRuleList_Click"
                            Background="Transparent" Foreground="#6C757D" BorderThickness="0" FontWeight="Bold" Cursor="Hand" FontSize="14"/>
                    
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Chi tiết bảng giá:" FontWeight="SemiBold" Margin="0,0,5,0" FontSize="16"/>
                        <TextBlock x:Name="lblSelectedRuleType" Text="VIP" FontWeight="Bold" Foreground="#007BFF" FontSize="16" Margin="0,0,20,0"/>

                        <!-- FILTER CONTROLS -->
                        <ComboBox x:Name="cboDetailCategory" Width="180" Height="30" Margin="0,0,10,0"
                                  SelectionChanged="CboDetailCategory_SelectionChanged" VerticalContentAlignment="Center"/>
                        
                        <!-- [MODIFIED] Wider Search + Placeholder -->
                        <Grid>
                            <TextBox x:Name="txtDetailSearch" Width="300" Height="30" Padding="5,0"
                                     VerticalContentAlignment="Center" BorderBrush="#CED4DA"
                                     TextChanged="TxtDetailSearch_TextChanged"/>
                            <TextBlock Text="🔍 Nhập để tìm kiếm..." IsHitTestVisible="False" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="#999">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=txtDetailSearch}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </StackPanel>

                    <!-- Group adjust: +/- X nghìn cho toàn bộ món trong nhóm (theo danh mục đang chọn) -->
                    <StackPanel DockPanel.Dock="Right"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="0,0,10,0">
                        <TextBlock Text="Điều chỉnh nhóm:" FontWeight="SemiBold" Foreground="#374151" VerticalAlignment="Center" Margin="0,0,8,0"/>

                        <TextBox x:Name="txtGroupDeltaK"
                                 Width="70"
                                 Height="30"
                                 Padding="6,0"
                                 VerticalContentAlignment="Center"
                                 BorderBrush="#CED4DA"
                                 PreviewTextInput="NumberOnly_PreviewTextInput"
                                 Text="1"/>
                        <TextBlock Text="nghìn" Foreground="#6B7280" VerticalAlignment="Center" Margin="6,0,10,0"/>

                        <Button Content="+ Tăng"
                                Height="30"
                                Padding="10,0"
                                Margin="0,0,6,0"
                                Click="BtnGroupIncrease_Click"
                                Background="#198754"
                                Foreground="White"
                                FontWeight="Bold"
                                BorderThickness="0"
                                Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <Button Content="- Giảm"
                                Height="30"
                                Padding="10,0"
                                Click="BtnGroupDecrease_Click"
                                Background="#DC3545"
                                Foreground="White"
                                FontWeight="Bold"
                                BorderThickness="0"
                                Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>

                    <!-- [MODIFIED] Smaller button, right aligned -->
                    <Button DockPanel.Dock="Right" Content="💾 Lưu lại" Click="BtnSaveRuleDetails_Click"
                            Padding="15,5" Background="#007BFF" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" FontSize="13">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </DockPanel>
            </Border>

            <!-- Detail List -->
            <DataGrid x:Name="dgRuleDetails" Grid.Row="1" Margin="20"
                      AutoGenerateColumns="False" CanUserAddRows="False"
                      Background="White" RowHeight="40" BorderThickness="1" BorderBrush="#DEE2E6">
                 <DataGrid.ItemContainerStyle>
                     <Style TargetType="DataGridRow">
                         <Setter Property="Background" Value="{Binding RowBackground}"/>
                     </Style>
                 </DataGrid.ItemContainerStyle>
                 <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F8F9FA"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Padding" Value="10,12"/>
                        <Setter Property="BorderBrush" Value="#DEE2E6"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Tên Sản Phẩm" Binding="{Binding DishName}" Width="*" IsReadOnly="True" FontWeight="SemiBold"/>
                    <DataGridTextColumn Header="Danh mục" Binding="{Binding CategoryName}" Width="150" IsReadOnly="True" FontWeight="SemiBold"/>
                    <DataGridTextColumn Header="Đơn vị" Binding="{Binding Unit}" Width="100" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Giá Gốc" Binding="{Binding BasePrice, StringFormat=N0}" Width="150" IsReadOnly="True" Foreground="#666"/>
                    
                    <!-- NEW PRICE EDITABLE -->
                    <DataGridTemplateColumn Header="Giá Mới (Nhập giá)" Width="200">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding NewPrice, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}" 
                                         Padding="5" VerticalContentAlignment="Center" BorderBrush="#CED4DA"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

    </Grid>
</UserControl>


