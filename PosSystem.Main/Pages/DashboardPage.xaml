<Page x:Class="PosSystem.Main.Pages.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="700"
        d:DesignWidth="1000"
      Title="DashboardPage"
        Background="#F3F4F6">

    <Page.Resources>
        <Style x:Key="StatCardStyle"
                TargetType="Border">
            <Setter Property="Background"
                    Value="White"/>
            <Setter Property="CornerRadius"
                    Value="12"/>
            <Setter Property="Padding"
                    Value="20"/>
            <Setter Property="Margin"
                    Value="10"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10"
                            ShadowDepth="3"
                            Opacity="0.05"
                            Color="#000"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock x:Name="lblDashboardTitle" 
                           Text="KẾT QUẢ KINH DOANH TRONG NGÀY"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="#2C3E50"/>
                <TextBlock x:Name="txtDate"
                           Text="Loading..."
                           FontSize="14"
                           Foreground="#7F8C8D"
                           Margin="0,5,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <StackPanel.Resources>
                    <Style TargetType="{x:Type RadioButton}">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="#7F8C8D"/>
                        <Setter Property="BorderBrush" Value="#BDC3C7"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="Padding" Value="15,8"/>
                        <Setter Property="Margin" Value="5,0"/>
                        <Setter Property="FontSize" Value="13"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type RadioButton}">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="20"
                                            SnapsToDevicePixels="True">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#ECF0F1"/>
                                <Setter Property="BorderBrush" Value="#95A5A6"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="#3498DB"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="BorderBrush" Value="#3498DB"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Resources>
                <RadioButton Content="Hôm qua" Click="BtnYesterday_Click" GroupName="FilterDate"/>
                <RadioButton Content="Hôm nay" Click="BtnToday_Click" IsChecked="True" GroupName="FilterDate"/>
                <RadioButton Content="Tuần này" Click="BtnWeek_Click" GroupName="FilterDate"/>
                <RadioButton Content="Tháng này" Click="BtnMonth_Click" GroupName="FilterDate"/>
                <RadioButton Content="Năm này" Click="BtnYear_Click" GroupName="FilterDate"/>
            </StackPanel>
        </Grid>

        <UniformGrid Grid.Row="1"
                Columns="4">
            <Border Style="{StaticResource StatCardStyle}">
                <StackPanel>
                    <TextBlock Text="DOANH THU" FontSize="13" Foreground="#95A5A6" FontWeight="SemiBold"/>
                    <TextBlock x:Name="txtRevenue" Text="0" FontSize="26" FontWeight="Bold" Foreground="#27AE60" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource StatCardStyle}">
                <StackPanel>
                    <TextBlock Text="CHI PHÍ" FontSize="13" Foreground="#95A5A6" FontWeight="SemiBold"/>
                    <TextBlock x:Name="txtExpense" Text="0" FontSize="26" FontWeight="Bold" Foreground="#E74C3C" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource StatCardStyle}">
                <StackPanel>
                    <TextBlock Text="THỰC THU" FontSize="13" Foreground="#95A5A6" FontWeight="SemiBold"/>
                    <TextBlock x:Name="txtNetRevenue" Text="0" FontSize="26" FontWeight="Bold" Foreground="#2980B9" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource StatCardStyle}">
                <StackPanel>
                    <TextBlock Text="ĐƠN HÀNG"
                            FontSize="13"
                            Foreground="#95A5A6"
                            FontWeight="SemiBold"/>
                    <TextBlock x:Name="txtOrderCount"
                            Text="0"
                            FontSize="26"
                            FontWeight="Bold"
                            Foreground="#2980B9"
                            Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource StatCardStyle}">
                <StackPanel>
                    <TextBlock Text="BÀN CÓ KHÁCH"
                            FontSize="13"
                            Foreground="#95A5A6"
                            FontWeight="SemiBold"/>
                    <TextBlock x:Name="txtActiveTables"
                            Text="0"
                            FontSize="26"
                            FontWeight="Bold"
                            Foreground="#E67E22"
                            Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource StatCardStyle}">
                <StackPanel>
                    <TextBlock Text="TỔNG LY/MÓN"
                            FontSize="13"
                            Foreground="#95A5A6"
                            FontWeight="SemiBold"/>
                    <TextBlock x:Name="txtSoldItems"
                            Text="0"
                            FontSize="26"
                            FontWeight="Bold"
                            Foreground="#8E44AD"
                            Margin="0,5,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Grid Grid.Row="2"
                Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1.5*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Style="{StaticResource StatCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="🔥 Món bán chạy"
                            FontSize="16"
                            FontWeight="Bold"
                            Foreground="#34495E"
                            Margin="0,0,0,15"/>
                    <ScrollViewer Grid.Row="1"
                            VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="lvTopProducts">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0"
                                                Margin="0,0,0,4">
                                            <TextBlock Text="{Binding Name}"
                                                    FontWeight="SemiBold"
                                                    Foreground="#2C3E50"
                                                    TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding QuantityStr}"
                                                    HorizontalAlignment="Right"
                                                    Foreground="#7F8C8D"
                                                    FontSize="12"/>
                                        </Grid>
                                        <Border Grid.Row="1"
                                                Height="5"
                                                Background="#ECF0F1"
                                                CornerRadius="2">
                                            <Border HorizontalAlignment="Left"
                                                    Background="#E74C3C"
                                                    CornerRadius="2"
                                                    Width="{Binding BarWidth}"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Style="{StaticResource StatCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="📊 Theo nhóm món"
                            FontSize="16"
                            FontWeight="Bold"
                            Foreground="#34495E"
                            Margin="0,0,0,15"/>
                    <ScrollViewer Grid.Row="1"
                            VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="lvCategories">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0"
                                                Margin="0,0,0,4">
                                            <TextBlock Text="{Binding Name}"
                                                    FontWeight="SemiBold"
                                                    Foreground="#2C3E50"/>
                                            <TextBlock Text="{Binding TotalAmountStr}"
                                                    HorizontalAlignment="Right"
                                                    Foreground="#27AE60"
                                                    FontWeight="Bold"
                                                    FontSize="12"/>
                                        </Grid>
                                        <Border Grid.Row="1"
                                                Height="5"
                                                Background="#ECF0F1"
                                                CornerRadius="2">
                                            <Border HorizontalAlignment="Left"
                                                    Background="#27AE60"
                                                    CornerRadius="2"
                                                    Width="{Binding BarWidth}"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Style="{StaticResource StatCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="🕒 Đơn hàng mới"
                            FontSize="16"
                            FontWeight="Bold"
                            Foreground="#34495E"
                            Margin="0,0,0,10"/>

                    <DataGrid x:Name="dgRecentOrders"
                            Grid.Row="1"
                            AutoGenerateColumns="False"
                              HeadersVisibility="Column"
                            GridLinesVisibility="Horizontal"
                              Background="White"
                            BorderThickness="0"
                            IsReadOnly="True"
                              RowHeight="35">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Bàn"
                                    Binding="{Binding TableName}"
                                    Width="80"/>
                            <DataGridTextColumn Header="Giờ"
                                    Binding="{Binding Time}"
                                    Width="60"/>
                            <DataGridTextColumn Header="Tiền"
                                    Binding="{Binding Total}"
                                    Width="*"
                                    FontWeight="Bold"/>
                            <DataGridTemplateColumn Header="TT"
                                    Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Status}"
                                                Foreground="{Binding StatusColor}"
                                                FontWeight="Bold"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>