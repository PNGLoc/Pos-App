<Page x:Class="PosSystem.Main.Pages.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="700"
        d:DesignWidth="1000"
      Title="DashboardPage"
        Background="#F3F4F6">

    <Page.Resources>
        <Style x:Key="StatCardStyle"
                TargetType="Border">
            <Setter Property="Background"
                    Value="White"/>
            <Setter Property="CornerRadius"
                    Value="12"/>
            <Setter Property="Padding"
                    Value="20"/>
            <Setter Property="Margin"
                    Value="10"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10"
                            ShadowDepth="3"
                            Opacity="0.05"
                            Color="#000"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                Margin="10,0,0,20">
            <TextBlock Text="KẾT QUẢ KINH DOANH TRONG NGÀY"
                    FontSize="22"
                    FontWeight="Bold"
                    Foreground="#2C3E50"/>
            <TextBlock x:Name="txtDate"
                    Text="Loading..."
                    FontSize="14"
                    Foreground="#7F8C8D"
                    Margin="0,5,0,0"/>
        </StackPanel>

        <UniformGrid Grid.Row="1"
                Columns="4">
            <Border Style="{StaticResource StatCardStyle}">
                <StackPanel>
                    <TextBlock Text="DOANH THU"
                            FontSize="13"
                            Foreground="#95A5A6"
                            FontWeight="SemiBold"/>
                    <TextBlock x:Name="txtRevenue"
                            Text="0 đ"
                            FontSize="26"
                            FontWeight="Bold"
                            Foreground="#27AE60"
                            Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource StatCardStyle}">
                <StackPanel>
                    <TextBlock Text="ĐƠN HÀNG"
                            FontSize="13"
                            Foreground="#95A5A6"
                            FontWeight="SemiBold"/>
                    <TextBlock x:Name="txtOrderCount"
                            Text="0"
                            FontSize="26"
                            FontWeight="Bold"
                            Foreground="#2980B9"
                            Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource StatCardStyle}">
                <StackPanel>
                    <TextBlock Text="BÀN CÓ KHÁCH"
                            FontSize="13"
                            Foreground="#95A5A6"
                            FontWeight="SemiBold"/>
                    <TextBlock x:Name="txtActiveTables"
                            Text="0"
                            FontSize="26"
                            FontWeight="Bold"
                            Foreground="#E67E22"
                            Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource StatCardStyle}">
                <StackPanel>
                    <TextBlock Text="TỔNG LY/MÓN"
                            FontSize="13"
                            Foreground="#95A5A6"
                            FontWeight="SemiBold"/>
                    <TextBlock x:Name="txtSoldItems"
                            Text="0"
                            FontSize="26"
                            FontWeight="Bold"
                            Foreground="#8E44AD"
                            Margin="0,5,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Grid Grid.Row="2"
                Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1.5*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Style="{StaticResource StatCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="🔥 Món bán chạy"
                            FontSize="16"
                            FontWeight="Bold"
                            Foreground="#34495E"
                            Margin="0,0,0,15"/>
                    <ScrollViewer Grid.Row="1"
                            VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="lvTopProducts">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0"
                                                Margin="0,0,0,4">
                                            <TextBlock Text="{Binding Name}"
                                                    FontWeight="SemiBold"
                                                    Foreground="#2C3E50"
                                                    TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding QuantityStr}"
                                                    HorizontalAlignment="Right"
                                                    Foreground="#7F8C8D"
                                                    FontSize="12"/>
                                        </Grid>
                                        <Border Grid.Row="1"
                                                Height="5"
                                                Background="#ECF0F1"
                                                CornerRadius="2">
                                            <Border HorizontalAlignment="Left"
                                                    Background="#E74C3C"
                                                    CornerRadius="2"
                                                    Width="{Binding BarWidth}"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Style="{StaticResource StatCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="📊 Theo nhóm món"
                            FontSize="16"
                            FontWeight="Bold"
                            Foreground="#34495E"
                            Margin="0,0,0,15"/>
                    <ScrollViewer Grid.Row="1"
                            VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="lvCategories">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0"
                                                Margin="0,0,0,4">
                                            <TextBlock Text="{Binding Name}"
                                                    FontWeight="SemiBold"
                                                    Foreground="#2C3E50"/>
                                            <TextBlock Text="{Binding TotalAmountStr}"
                                                    HorizontalAlignment="Right"
                                                    Foreground="#27AE60"
                                                    FontWeight="Bold"
                                                    FontSize="12"/>
                                        </Grid>
                                        <Border Grid.Row="1"
                                                Height="5"
                                                Background="#ECF0F1"
                                                CornerRadius="2">
                                            <Border HorizontalAlignment="Left"
                                                    Background="#27AE60"
                                                    CornerRadius="2"
                                                    Width="{Binding BarWidth}"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Style="{StaticResource StatCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="🕒 Đơn hàng mới"
                            FontSize="16"
                            FontWeight="Bold"
                            Foreground="#34495E"
                            Margin="0,0,0,10"/>

                    <DataGrid x:Name="dgRecentOrders"
                            Grid.Row="1"
                            AutoGenerateColumns="False"
                              HeadersVisibility="Column"
                            GridLinesVisibility="Horizontal"
                              Background="White"
                            BorderThickness="0"
                            IsReadOnly="True"
                              RowHeight="35">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Bàn"
                                    Binding="{Binding TableName}"
                                    Width="80"/>
                            <DataGridTextColumn Header="Giờ"
                                    Binding="{Binding Time}"
                                    Width="60"/>
                            <DataGridTextColumn Header="Tiền"
                                    Binding="{Binding Total}"
                                    Width="*"
                                    FontWeight="Bold"/>
                            <DataGridTemplateColumn Header="TT"
                                    Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Status}"
                                                Foreground="{Binding StatusColor}"
                                                FontWeight="Bold"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>