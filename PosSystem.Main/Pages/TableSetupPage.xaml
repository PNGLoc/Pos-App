<UserControl x:Class="PosSystem.Main.Pages.TableSetupPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="900"
             Background="White">
    <Grid>
        <!-- MAIN CONTENT -->
        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- TOP BAR -->
            <DockPanel Grid.Row="0"
                       Margin="0,0,0,15">
                <TextBlock Text="🎯 QUẢN LÝ BÀN ĂN"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="#333"
                           VerticalAlignment="Center"
                           DockPanel.Dock="Left"/>

                <Button Content="➕ THÊM BÀN MỚI"
                        Click="BtnAdd_Click"
                        DockPanel.Dock="Right"
                        Padding="15,8"
                        Background="#28A745"
                        Foreground="White"
                        FontWeight="Bold"
                        FontSize="13"
                        BorderThickness="0"
                        HorizontalAlignment="Right"
        Width="Auto"
                        Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius"
                                    Value="4"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </DockPanel>

            <!-- LIST -->
            <DataGrid x:Name="dgTables"
                      Grid.Row="1"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      BorderThickness="1"
                      BorderBrush="#DEE2E6"
                      RowHeight="40"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      Background="White">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background"
                                Value="#F8F9FA"/>
                        <Setter Property="FontWeight"
                                Value="Bold"/>
                        <Setter Property="Padding"
                                Value="10,12"/>
                        <Setter Property="BorderBrush"
                                Value="#DEE2E6"/>
                        <Setter Property="BorderThickness"
                                Value="0,0,0,1"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding"
                                Value="10,0"/>
                        <Setter Property="VerticalContentAlignment"
                                Value="Center"/>
                        <Setter Property="BorderThickness"
                                Value="0"/>
                    </Style>
                </DataGrid.CellStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID"
                                        Binding="{Binding TableID}"
                                        Width="60"/>
                    <DataGridTextColumn Header="Tên bàn"
                                        Binding="{Binding TableName}"
                                        Width="*"
                                        FontWeight="SemiBold"/>
                    <DataGridTextColumn Header="Loại bàn / Khu vực"
                                        Binding="{Binding Category.CategoryName}"
                                        Width="150"/>
                    <DataGridTextColumn Header="Trạng thái"
                                        Binding="{Binding TableStatus}"
                                        Width="150"/>
                    
                    <DataGridTemplateColumn Header="Hành động"
                                            Width="180">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="✏️ Sửa"
                                            Click="BtnEditRow_Click"
                                            Tag="{Binding}"
                                            Width="70"
                                            Height="30"
                                            Margin="0,0,8,0"
                                            Background="#FFC107"
                                            Foreground="#333"
                                            BorderThickness="0"
                                            Cursor="Hand">
                                         <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="3"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                    <Button Content="🗑️ Xóa"
                                            Click="BtnDeleteRow_Click"
                                            Tag="{Binding}"
                                            Width="70"
                                            Height="30"
                                            Background="#DC3545"
                                            Foreground="White"
                                            BorderThickness="0"
                                            Cursor="Hand">
                                         <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="3"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- MODAL OVERLAY -->
        <Grid x:Name="modalOverlay"
              Visibility="Collapsed">
            <!-- Background mờ -->
            <Border Background="#99000000"
                    MouseDown="BtnCloseModal_Click"/>

            <!-- Form -->
            <Border Background="White"
                    Width="400"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    CornerRadius="8"
                    Padding="25">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30"
                                      ShadowDepth="0"
                                      Opacity="0.3"/>
                </Border.Effect>

                <StackPanel>
                    <TextBlock x:Name="lblModalTitle"
                               Text="SỬA THÔNG TIN BÀN"
                               FontSize="18"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,20"
                               Foreground="#007BFF"/>

                    <TextBlock Text="Tên bàn (Vd: Bàn 1):"
                               FontWeight="SemiBold"
                               Margin="0,0,0,5"/>
                    <TextBox x:Name="txtName"
                             Height="38"
                             Margin="0,0,0,15"
                             Padding="8,0"
                             VerticalContentAlignment="Center"
                             BorderBrush="#CED4DA"/>

                    <TextBlock Text="Loại bàn:"
                               FontWeight="SemiBold"
                               Margin="0,0,0,5"/>
                    <ComboBox x:Name="cboType"
                              Height="38"
                              Margin="0,0,0,25"
                              Padding="8,5"
                              ItemsSource="{Binding Categories}"
                              DisplayMemberPath="CategoryName"
                              SelectedValuePath="CategoryID"
                              BorderBrush="#CED4DA">
                    </ComboBox>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button Content="Hủy bỏ"
                                Click="BtnCloseModal_Click"
                                Width="100"
                                Height="38"
                                Margin="0,0,10,0"
                                Background="#F1F3F5"
                                Foreground="Black"
                                BorderThickness="0"
                                FontWeight="SemiBold"
                                Cursor="Hand">
                             <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Button Content="💾 LƯU LẠI"
                                Click="BtnSaveModal_Click"
                                Width="120"
                                Height="38"
                                Background="#007BFF"
                                Foreground="White"
                                FontWeight="Bold"
                                BorderThickness="0"
                                Cursor="Hand">
                             <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>