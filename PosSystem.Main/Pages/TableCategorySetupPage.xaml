<UserControl x:Class="PosSystem.Main.Pages.TableCategorySetupPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:helpers="clr-namespace:PosSystem.Main.Helpers"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="800"
             Background="#F4F6F9">

    <UserControl.Resources>
        <FontFamily x:Key="FaSolidFont">pack://application:,,,/Assets/Fonts/#Font Awesome 5 Free Solid</FontFamily>
        <helpers:FontAwesomeIconClassToGlyphConverter x:Key="FaClassToGlyph"/>

        <Style x:Key="SwitchToggleStyle"
                TargetType="ToggleButton">
            <Setter Property="Width"
                    Value="46"/>
            <Setter Property="Height"
                    Value="24"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border x:Name="track"
                                    Background="#D1D5DB"
                                    CornerRadius="12"/>
                            <Border x:Name="thumb"
                                    Width="20"
                                    Height="20"
                                    Background="White"
                                    CornerRadius="10"
                                    Margin="2,2,0,2"
                                    HorizontalAlignment="Left">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="4"
                                            ShadowDepth="1"
                                            Opacity="0.2"/>
                                </Border.Effect>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked"
                                    Value="True">
                                <Setter TargetName="track"
                                        Property="Background"
                                        Value="#28A745"/>
                                <Setter TargetName="thumb"
                                        Property="HorizontalAlignment"
                                        Value="Right"/>
                                <Setter TargetName="thumb"
                                        Property="Margin"
                                        Value="0,2,2,2"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver"
                                    Value="True">
                                <Setter TargetName="track"
                                        Property="Opacity"
                                        Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled"
                                    Value="False">
                                <Setter TargetName="track"
                                        Property="Opacity"
                                        Value="0.5"/>
                                <Setter TargetName="thumb"
                                        Property="Opacity"
                                        Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="White"
                Padding="20,15"
                Margin="0,0,0,15"
                CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="QUẢN LÝ LOẠI BÀN (KHU VỰC)"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#333"/>
                    <TextBlock Text="Thiết lập các khu vực hoặc loại bàn (Ví dụ: Tầng 1, VIP, Mang Về...)"
                               FontSize="13"
                               Foreground="#666"
                               Margin="0,5,0,0"/>
                    <StackPanel Orientation="Horizontal"
                            Margin="0,8,0,0"
                            VerticalAlignment="Center">
                        <ToggleButton x:Name="chkShowTableIcons"
                                      Style="{StaticResource SwitchToggleStyle}"
                                      Checked="ChkShowTableIcons_Checked"
                                      Unchecked="ChkShowTableIcons_Unchecked"/>
                        <TextBlock Text="Hiện icon loại bàn trên card (màn hình bán hàng)"
                                   FontSize="13"
                                   Foreground="#444"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="1"
                        Content="➕ THÊM LOẠI BÀN"
                        Width="150"
                        Height="35"
                        Background="#28A745"
                        Foreground="White"
                        FontWeight="Bold"
                        Click="BtnAdd_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius"
                                    Value="5"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Border>

        <!-- List -->
        <DataGrid Grid.Row="2"
                  x:Name="dgCategories"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  Background="White"
                  RowHeight="50"
                  IsReadOnly="True"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  BorderThickness="0">
            <DataGrid.Resources>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background"
                            Value="#F8F9FA"/>
                    <Setter Property="Padding"
                            Value="10,12"/>
                    <Setter Property="FontWeight"
                            Value="SemiBold"/>
                    <Setter Property="BorderThickness"
                            Value="0,0,0,1"/>
                    <Setter Property="BorderBrush"
                            Value="#E0E0E0"/>
                </Style>
                <Style TargetType="DataGridCell">
                    <Setter Property="Padding"
                            Value="10,0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridCell">
                                <Border Padding="{TemplateBinding Padding}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        Background="{TemplateBinding Background}"
                                        SnapsToDevicePixels="True">
                                    <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsSelected"
                                 Value="True">
                            <Setter Property="Background"
                                    Value="#E3F2FD"/>
                            <Setter Property="Foreground"
                                    Value="Black"/>
                            <Setter Property="BorderThickness"
                                    Value="0"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.Resources>

            <DataGrid.Columns>
                <DataGridTextColumn Header="ID"
                                    Binding="{Binding CategoryID}"
                                    Width="60"/>
                <DataGridTextColumn Header="Thứ tự hiển thị"
                                    Binding="{Binding DisplayOrder}"
                                    Width="*"/>
                <DataGridTextColumn Header="Tên Loại Bàn / Khu Vực"
                                    Binding="{Binding CategoryName}"
                                    Width="*"/>
                <DataGridTextColumn Header="Mô tả"
                                    Binding="{Binding Description}"
                                    Width="2*"/>
                <DataGridTemplateColumn Header="Màu viền"
                                        Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <Border Width="36"
                                        Height="18"
                                        CornerRadius="3"
                                        BorderThickness="2"
                                        BorderBrush="{Binding BorderColorHex}"/>
                                <TextBlock Text="{Binding BorderColorHex}"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="#555"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Icon (FA)"
                                        Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding IconClass, Converter={StaticResource FaClassToGlyph}}"
                                       FontFamily="{StaticResource FaSolidFont}"
                                       FontSize="16"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       ToolTip="{Binding IconClass}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Thao tác"
                                        Width="140">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right">
                                <Button Content="✏ Sửa"
                                        Width="60"
                                        Height="30"
                                        Margin="0,0,5,0"
                                        Background="#FFC107"
                                        Foreground="Black"
                                        Click="BtnEditRow_Click"
                                        Tag="{Binding}"/>
                                <Button Content="🗑 Xóa"
                                        Width="60"
                                        Height="30"
                                        Background="#DC3545"
                                        Foreground="White"
                                        Click="BtnDeleteRow_Click"
                                        Tag="{Binding}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Modal Overlay -->
        <Grid Grid.RowSpan="3"
              x:Name="modalOverlay"
              Background="#99000000"
              Visibility="Collapsed">
            <Border Width="400"
                    Height="Auto"
                    Background="White"
                    CornerRadius="8"
                    Padding="20"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock x:Name="lblModalTitle"
                               Text="THÊM LOẠI BÀN"
                               FontSize="18"
                               FontWeight="Bold"
                               Margin="0,0,0,15"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="Tên loại bàn / Khu vực (*)"
                               FontWeight="SemiBold"
                               Margin="0,0,0,5"/>
                    <TextBox x:Name="txtName"
                             Height="35"
                             Padding="5,8"/>

                    <TextBlock Text="Thứ tự hiển thị"
                               FontWeight="SemiBold"
                               Margin="0,15,0,5"/>
                    <TextBox x:Name="txtDisplayOrder"
                             Height="35"
                             Padding="5,8"/>

                    <TextBlock Text="Mô tả"
                               FontWeight="SemiBold"
                               Margin="0,15,0,5"/>
                    <TextBox x:Name="txtDesc"
                             Height="35"
                             Padding="5,8"/>

                    <TextBlock Text="Màu viền (Hex, ví dụ #4F8EF7)"
                               FontWeight="SemiBold"
                               Margin="0,15,0,5"/>
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <TextBox x:Name="txtBorderColor"
                                 Height="35"
                                 Padding="5,8"
                                 Width="200"
                                 TextChanged="TxtBorderColor_TextChanged"/>
                        <Border x:Name="previewBorderColor"
                                Width="50"
                                Height="20"
                                CornerRadius="3"
                                BorderThickness="2"
                                Margin="12,0,0,0"
                                BorderBrush="#D0D0D0"/>
                    </StackPanel>

                    <TextBlock Text="Icon (Font Awesome)"
                               FontWeight="SemiBold"
                               Margin="0,15,0,5"/>
                    <ComboBox x:Name="cmbIconClass"
                              Height="35"
                              Padding="6,4"
                              VerticalContentAlignment="Center">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Glyph}"
                                               FontFamily="{StaticResource FaSolidFont}"
                                               FontSize="16"
                                               Width="22"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Name}"
                                               Margin="8,0,0,0"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Class}"
                                               Margin="8,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="#888"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,20,0,0">
                        <Button Content="Hủy bỏ"
                                Width="100"
                                Height="35"
                                Background="#6C757D"
                                Foreground="White"
                                Margin="0,0,10,0"
                                Click="BtnCloseModal_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius"
                                            Value="5"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Button Content="Lưu lại"
                                Width="100"
                                Height="35"
                                Background="#007BFF"
                                Foreground="White"
                                Click="BtnSaveModal_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius"
                                            Value="5"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
