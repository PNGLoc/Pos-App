<Window x:Class="PosSystem.Main.EditItemPriceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Điều chỉnh giá món"
        Height="260"
        Width="360"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="White"
        BorderBrush="#007BFF"
        BorderThickness="1">

    <Window.Resources>
        <Style x:Key="CloseIconButton"
               TargetType="Button">
            <Setter Property="Width"
                    Value="28"/>
            <Setter Property="Height"
                    Value="28"/>
            <Setter Property="FontSize"
                    Value="14"/>
            <Setter Property="FontWeight"
                    Value="Bold"/>
            <Setter Property="Foreground"
                    Value="#374151"/>
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="FocusVisualStyle"
                    Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="#F3F4F6"/>
                            </Trigger>
                            <Trigger Property="IsPressed"
                                     Value="True">
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="#E5E7EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Điều chỉnh giá món"
                   FontSize="18"
                   FontWeight="Bold"
                   Foreground="#1F2937"
                   Margin="0,0,0,10"/>

        <!-- Close (Cancel) button -->
        <Button x:Name="btnClose"
                Content="✕"
                Style="{StaticResource CloseIconButton}"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,0,0,0"
                Panel.ZIndex="10"
                Click="BtnCancel_Click"
                IsCancel="True"/>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Margin="0,0,0,6">
            <TextBlock Text="Giá gốc: "
                       Foreground="#666"/>
            <TextBlock x:Name="txtOriginalPrice"
                       FontWeight="Bold"
                       Foreground="#111"
                       Text="0"/>
            <TextBlock Text=" đ"
                       Foreground="#666"/>
        </StackPanel>

        <StackPanel Grid.Row="2"
                    Margin="0,0,0,6">
            <TextBlock Text="Nhập giá mới (đ):"
                       Foreground="#666"
                       Margin="0,0,0,4"/>
            <TextBox x:Name="txtNewPrice"
                     Height="40"
                     FontSize="20"
                     FontWeight="Bold"
                     HorizontalContentAlignment="Center"
                     PreviewTextInput="NumberValidationTextBox"
                     GotFocus="Txt_GotFocus"
                     TextChanged="TxtNewPrice_TextChanged"/>
        </StackPanel>

        <TextBlock Grid.Row="3"
                   x:Name="txtDeltaHint"
                   Text=""
                   FontSize="12"
                   Foreground="#DC3545"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Top"
                   Margin="0,6,0,0"/>

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,12,0,0">
            <Button Content="KHÔI PHỤC"
                    Width="90"
                    Height="38"
                    Margin="0,0,10,0"
                    Click="BtnUndo_Click"
                    FontWeight="Bold"
                    Foreground="White"
                    Background="#FD7E14"/>
            <Button Content="XÁC NHẬN"
                    Width="110"
                    Height="38"
                    Background="#007BFF"
                    Foreground="White"
                    FontWeight="Bold"
                    Click="BtnOK_Click"
                    IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
