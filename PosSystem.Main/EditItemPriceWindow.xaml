<Window x:Class="PosSystem.Main.EditItemPriceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Điều chỉnh giá món"
        Height="260"
        Width="360"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="White"
        BorderBrush="#007BFF"
        BorderThickness="1">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Điều chỉnh giá món"
                   FontSize="18"
                   FontWeight="Bold"
                   Foreground="#1F2937"
                   Margin="0,0,0,10"/>

        <StackPanel Grid.Row="1"
                Orientation="Horizontal"
                Margin="0,0,0,6">
            <TextBlock Text="Giá gốc: "
                    Foreground="#666"/>
            <TextBlock x:Name="txtOriginalPrice"
                       FontWeight="Bold"
                       Foreground="#111"
                       Text="0"/>
            <TextBlock Text=" đ"
                    Foreground="#666"/>
        </StackPanel>

        <StackPanel Grid.Row="2"
                Margin="0,0,0,6">
            <TextBlock Text="Nhập giá mới (đ):"
                    Foreground="#666"
                    Margin="0,0,0,4"/>
            <TextBox x:Name="txtNewPrice"
                     Height="40"
                     FontSize="20"
                     FontWeight="Bold"
                     HorizontalContentAlignment="Center"
                     PreviewTextInput="NumberValidationTextBox"
                     GotFocus="Txt_GotFocus"
                     TextChanged="TxtNewPrice_TextChanged"/>
        </StackPanel>

        <TextBlock Grid.Row="3"
                   x:Name="txtDeltaHint"
                   Text=""
                   FontSize="12"
                   Foreground="#DC3545"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Top"
                   Margin="0,6,0,0"/>

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,12,0,0">
            <Button Content="Hoàn tác"
                    Width="90"
                    Height="38"
                    Margin="0,0,10,0"
                    Click="BtnUndo_Click"
                    Background="#F3F4F6"/>
            <Button Content="Hủy"
                    Width="80"
                    Height="38"
                    Margin="0,0,10,0"
                    Click="BtnCancel_Click"
                    Background="#EEE"/>
            <Button Content="XÁC NHẬN"
                    Width="110"
                    Height="38"
                    Background="#007BFF"
                    Foreground="White"
                    FontWeight="Bold"
                    Click="BtnOK_Click"
                    IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
