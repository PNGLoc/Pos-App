<Window x:Class="PosSystem.Main.ExpenseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nhập khoản chi" Height="405" Width="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Border Background="White"
            CornerRadius="15"
            Margin="20">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25"
                              ShadowDepth="5"
                              Opacity="0.4"/>
        </Border.Effect>

        <Grid>
            <!-- Close Button -->
            <Button Content="❌"
                    Click="BtnCancel_Click"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Width="40"
                    Height="40"
                    Margin="0,5,5,0"
                    Background="Transparent"
                    BorderThickness="0"
                    FontSize="16"
                    Cursor="Hand"/>

            <StackPanel Margin="30">
                <TextBlock Text="💸 NHẬP KHOẢN CHI"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="#333"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>

                <!-- SỐ TIỀN -->
                <TextBlock Text="Số tiền chi:" FontSize="14" FontWeight="Bold" Margin="0,0,0,5"/>
                <Border BorderBrush="#DDD" BorderThickness="1" CornerRadius="5" Margin="0,0,0,10">
                    <TextBox x:Name="txtAmount" Height="35" Padding="5" FontSize="16" 
                             VerticalContentAlignment="Center" BorderThickness="0" Background="Transparent"
                             PreviewTextInput="NumberValidationTextBox" TextChanged="TxtAmount_TextChanged"/>
                </Border>


                <!-- GHI CHÚ (Removed Category) -->
                <TextBlock Text="Ghi chú / Lý do:" FontSize="14" FontWeight="Bold" Margin="0,0,0,5"/>
                <Border BorderBrush="#DDD" BorderThickness="1" CornerRadius="5" Margin="0,0,0,10">
                    <TextBox x:Name="txtNote" Height="70" TextWrapping="Wrap" Padding="5" 
                             VerticalContentAlignment="Top" BorderThickness="0" Background="Transparent"
                             AcceptsReturn="True"/>
                </Border>



                <!-- Status Message -->
                <TextBlock x:Name="lblMessage"
                           Text=""
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10"
                           FontSize="14"
                           FontWeight="Bold"
                           TextWrapping="Wrap"
                           TextAlignment="Center"/>

                <!-- BUTTONS -->
                <Button Content="✅ HOÀN THÀNH" 
                        Width="200" 
                        Height="45" 
                        Background="#28A745" 
                        Foreground="White" 
                        FontWeight="Bold" 
                        FontSize="16"
                        Click="BtnSave_Click"
                        HorizontalAlignment="Center">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="22"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
