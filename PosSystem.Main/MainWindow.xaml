<Window x:Class="PosSystem.Main.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PosSystem.Main"
        xmlns:helpers="clr-namespace:PosSystem.Main.Helpers"
        Title="LP_Pos - QUẢN LÝ BÀN"
        WindowState="Maximized"
        Background="#F0F2F5">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <FontFamily x:Key="FaSolidFont">pack://application:,,,/Assets/Fonts/#Font Awesome 5 Free Solid</FontFamily>

        <local:EmptyStringToVisibilityConverter x:Key="EmptyStringToVisibilityConverter"/>
        <local:NotEmptyStringToVisibilityConverter x:Key="NotEmptyStringToVisibilityConverter"/>

        <helpers:DishImagePathToImageSourceConverter x:Key="DishImagePathToImageSourceConverter"/>
        <helpers:DishImagePathToVisibilityConverter x:Key="DishImagePathToVisibilityConverter"/>

        <Style x:Key="PrinterToggleStyle"
               TargetType="ToggleButton">
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border"
                                CornerRadius="5"
                                Padding="10,5"
                                BorderThickness="0">
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center">
                                <TextBlock x:Name="txtIcon"
                                           Text="🖨"
                                           Margin="0,0,5,0"
                                           Foreground="White"
                                           FontWeight="Bold"/>
                                <TextBlock x:Name="txtStatus"
                                           Text="In Bill: Bật"
                                           Foreground="White"
                                           FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked"
                                     Value="True">
                                <Setter TargetName="border"
                                        Property="Background"
                                        Value="#47a67f"/>
                                <Setter TargetName="txtStatus"
                                        Property="Text"
                                        Value="In Bill: Bật"/>
                                <Setter TargetName="txtIcon"
                                        Property="Text"
                                        Value="🖨"/>
                            </Trigger>
                            <Trigger Property="IsChecked"
                                     Value="False">
                                <Setter TargetName="border"
                                        Property="Background"
                                        Value="#DC3545"/>
                                <Setter TargetName="txtStatus"
                                        Property="Text"
                                        Value="In Bill: Tắt"/>
                                <Setter TargetName="txtIcon"
                                        Property="Text"
                                        Value="🚫"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked"
                         Value="False">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever"
                                        AutoReverse="True">
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 From="1.0"
                                                 To="0.4"
                                                 Duration="0:0:0.8"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 To="1.0"
                                                 Duration="0:0:0.1"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NoteTextBoxStyle"
               TargetType="TextBox">
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="Foreground"
                    Value="Gray"/>
            <Setter Property="FontStyle"
                    Value="Italic"/>
            <Setter Property="Padding"
                    Value="0,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused"
                                     Value="True">
                                <Setter Property="BorderThickness"
                                        Value="1"/>
                                <Setter Property="BorderBrush"
                                        Value="#007BFF"/>
                                <Setter Property="Foreground"
                                        Value="Black"/>
                                <Setter Property="FontStyle"
                                        Value="Normal"/>
                            </Trigger>

                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter Property="BorderThickness"
                                        Value="1"/>
                                <Setter Property="BorderBrush"
                                        Value="#DEE2E6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="540"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Row="0"
                    Grid.Column="0"
                    Background="White"
                    CornerRadius="8"
                    Padding="15,12"
                    Margin="0,0,10,10">
                <Border.Effect>
                    <DropShadowEffect Color="Gray"
                                      BlurRadius="5"
                                      ShadowDepth="1"
                                      Opacity="0.1"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal"
                                    Margin="0,0,30,0">
                            <TextBlock Text="Thu ngân: "
                                       Foreground="#666"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="lblStaffName"
                                       Text="..."
                                       FontWeight="Bold"
                                       Foreground="#007BFF"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Content="🚪 ĐĂNG XUẤT"
                                Click="BtnLogout_Click"
                                Height="35"
                                Background="#6c757d"
                                Foreground="White"
                                Padding="15,0"
                                BorderThickness="0"
                                FontWeight="SemiBold"
                                Margin="0,0,10,0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius"
                                            Value="5"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Button x:Name="btnBackToAdmin"
                                Content="⚙ ADMIN"
                                Click="BtnBackToAdmin_Click"
                                Height="35"
                                Background="#6c757d"
                                Foreground="White"
                                Padding="15,0"
                                BorderThickness="0"
                                FontWeight="SemiBold"
                                Margin="0,0,10,0"
                                Visibility="Collapsed">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius"
                                            Value="5"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <Button Content="💸 NHẬP CHI"
                                Click="BtnExpense_Click"
                                Height="35"
                                Background="#47a67f"
                                Foreground="White"
                                Padding="15,0"
                                BorderThickness="0"
                                FontWeight="SemiBold"
                                Margin="0,0,10,0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius"
                                            Value="5"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <Button Content="📜 LỊCH SỬ"
                                Click="BtnHistory_Click"
                                Height="35"
                                Background="#47a67f"
                                Foreground="White"
                                Padding="15,0"
                                BorderThickness="0"
                                Margin="0,0,10,0"
                                FontWeight="SemiBold">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius"
                                            Value="5"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Button Content="⏰ CHẤM CÔNG"
                                Click="BtnTimeKeeping_Click"
                                Height="35"
                                Background="#47a67f"
                                Foreground="White"
                                Padding="15,0"
                                BorderThickness="0"
                                FontWeight="SemiBold"
                                Margin="0,0,10,0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius"
                                            Value="5"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                    </StackPanel>

                    <ToggleButton Grid.Column="1"
                                  x:Name="tglPrintBill"
                                  Style="{StaticResource PrinterToggleStyle}"
                                  IsChecked="True"
                                  Height="35"
                                  VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Grid.Column="0"
                    Margin="0,0,10,0"
                    Background="White"
                    CornerRadius="8">
                <Border.Effect>
                    <DropShadowEffect Color="Gray"
                                      BlurRadius="10"
                                      ShadowDepth="0"
                                      Opacity="0.2"/>
                </Border.Effect>

                <Grid>
                    <Grid x:Name="pnlTableList"
                          Visibility="Visible">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <!-- 0. Title/Filter -->
                            <RowDefinition Height="*"/>
                            <!-- 1. Tables -->
                        </Grid.RowDefinitions>

                        <!-- Title + Filter Bar -->
                        <Border Grid.Row="0"
                                Background="White"
                                Padding="20,15"
                                BorderThickness="0,0,0,1"
                                BorderBrush="#E0E0E0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Title -->
                                <TextBlock Grid.Column="0"
                                           Text="SƠ ĐỒ BÀN"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="#333"
                                           VerticalAlignment="Center"/>

                                <Border Grid.Column="1"
                                        x:Name="bdTableSearch"
                                        Background="#F8F9FA"
                                        CornerRadius="8"
                                        Margin="12,0,0,0"
                                        VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush"
                                                    Value="#D0D7DE"/>
                                            <Setter Property="BorderThickness"
                                                    Value="1"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ElementName=txtTableSearch, Path=IsKeyboardFocusWithin}"
                                                             Value="True">
                                                    <Setter Property="BorderBrush"
                                                            Value="#007BFF"/>
                                                    <Setter Property="BorderThickness"
                                                            Value="1"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBox x:Name="txtTableSearch"
                                             Width="220"
                                             Height="34"
                                             Padding="10,6"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             FontSize="14"
                                             VerticalContentAlignment="Center"
                                             Text="Tìm bàn"
                                             Foreground="#9AA0A6"
                                             TextChanged="TxtTableSearch_TextChanged"
                                             GotFocus="TxtTableSearch_GotFocus"
                                             LostFocus="TxtTableSearch_LostFocus"
                                             KeyDown="TxtTableSearch_KeyDown"
                                             />
                                </Border>

                                <!-- Filter Bar -->
                                <StackPanel Grid.Column="2"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Margin="20,0,0,0">
                                    <StackPanel.Resources>
                                        <Style x:Key="TableFilterButtonStyle"
                                               TargetType="Button">
                                            <Setter Property="Height"
                                                    Value="34"/>
                                            <Setter Property="MinWidth"
                                                    Value="90"/>
                                            <Setter Property="Padding"
                                                    Value="10,5"/>
                                            <Setter Property="Margin"
                                                    Value="4,0"/>
                                            <Setter Property="Background"
                                                    Value="#F1F3F5"/>
                                            <Setter Property="Foreground"
                                                    Value="#495057"/>
                                            <Setter Property="BorderBrush"
                                                    Value="#D0D7DE"/>
                                            <Setter Property="BorderThickness"
                                                    Value="1"/>
                                            <Setter Property="FontSize"
                                                    Value="14"/>
                                            <Setter Property="FontWeight"
                                                    Value="SemiBold"/>
                                            <Setter Property="Cursor"
                                                    Value="Hand"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                CornerRadius="8">
                                                            <ContentPresenter HorizontalAlignment="Center"
                                                                              VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver"
                                                         Value="True">
                                                    <Setter Property="Background"
                                                            Value="#E9ECEF"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Resources>
                                    <Button x:Name="btnCancelMove"
                                            Content="❌ Hủy chuyển bàn"
                                            Background="#DC3545"
                                            Foreground="White"
                                            FontWeight="Bold"
                                            Padding="10,5"
                                            Margin="0,0,20,0"
                                            Visibility="Collapsed"
                                            Click="BtnCancelMove_Click">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius"
                                                        Value="5"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                    <Button x:Name="btnCancelSplit"
                                            Content="❌ Hủy tách bàn"
                                            Background="#DC3545"
                                            Foreground="White"
                                            FontWeight="Bold"
                                            Padding="10,5"
                                            Margin="0,0,20,0"
                                            Visibility="Collapsed"
                                            Click="BtnCancelSplit_Click">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius"
                                                        Value="5"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                    <TextBlock Text="Lọc:"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,0"
                                               FontWeight="Bold"
                                               Foreground="#666"/>
                                    <Button x:Name="btnFilterAll"
                                            Content="Tất cả"
                                            Style="{StaticResource TableFilterButtonStyle}"
                                            Click="BtnFilterAll_Click"
                                            Tag="All"/>

                                    <ItemsControl x:Name="icFilterCategories"
                                                  ItemsSource="{Binding FilterCategories}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Content="{Binding CategoryName}"
                                                        Tag="{Binding CategoryID}"
                                                        Style="{StaticResource TableFilterButtonStyle}"
                                                        Click="BtnFilterCategory_Click">
                                                    <Button.Resources>
                                                        <Style TargetType="Border">
                                                            <Setter Property="CornerRadius"
                                                                    Value="3"/>
                                                        </Style>
                                                    </Button.Resources>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <ListBox Grid.Row="1"
                                 x:Name="lstTables"
                                 SelectionChanged="lstTables_SelectionChanged"
                                 PreviewMouseLeftButtonUp="lstTables_PreviewMouseLeftButtonUp"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.CanContentScroll="True"
                                 ScrollViewer.IsDeferredScrollingEnabled="False"
                                 VirtualizingPanel.ScrollUnit="Pixel">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <helpers:VirtualizingWrapPanel ItemWidth="220"
                                                                   ItemHeight="170"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding"
                                            Value="0"/>
                                    <Setter Property="Margin"
                                            Value="0"/>
                                    <Setter Property="BorderThickness"
                                            Value="0"/>
                                    <Setter Property="Background"
                                            Value="Transparent"/>
                                    <Setter Property="HorizontalContentAlignment"
                                            Value="Stretch"/>
                                    <Setter Property="VerticalContentAlignment"
                                            Value="Stretch"/>
                                    <Setter Property="Focusable"
                                            Value="False"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="200"
                                            Height="150"
                                            Margin="10"
                                            CornerRadius="12"
                                            Cursor="Hand">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background"
                                                        Value="{Binding ColorBrush}"/>
                                                <Setter Property="BorderThickness"
                                                        Value="2"/>
                                                <Setter Property="BorderBrush"
                                                        Value="{Binding CategoryBorderBrush}"/>
                                                <Setter Property="Effect"
                                                        Value="{x:Null}"/>

                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver"
                                                             Value="True">
                                                        <Setter Property="BorderBrush"
                                                                Value="#2196F3"/>
                                                    </Trigger>

                                                    <DataTrigger Binding="{Binding HasProvisionalBill}"
                                                                 Value="True">
                                                        <Setter Property="Background"
                                                                Value="#A7D3F5"/>
                                                    </DataTrigger>

                                                    <DataTrigger Binding="{Binding HasUnsentItems}"
                                                                 Value="True">
                                                        <Setter Property="Background"
                                                                Value="#fff3cd"/>
                                                    </DataTrigger>

                                                    <DataTrigger Binding="{Binding IsRequestingPayment}"
                                                                 Value="True">
                                                        <Setter Property="Background"
                                                                Value="#FF746C"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <Grid>
                                            <TextBlock Text="{Binding CategoryIconGlyph}"
                                                       FontFamily="{StaticResource FaSolidFont}"
                                                       FontSize="22"
                                                       Opacity="0.9"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Top"
                                                       Margin="0,2,0,0"
                                                       Visibility="{Binding IsCategoryIconVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            <StackPanel VerticalAlignment="Center"
                                                        HorizontalAlignment="Center"
                                                        Margin="0,6,0,0">
                                                <TextBlock Text="{Binding TableName}"
                                                           Foreground="{Binding TextBrush}"
                                                           FontWeight="Bold"
                                                           FontSize="20"
                                                           TextAlignment="Center"
                                                           TextWrapping="Wrap"
                                                           TextTrimming="None"
                                                           MaxWidth="185"/>
                                                <TextBlock Text="{Binding TimeDisplay}"
                                                           Foreground="{Binding TextBrush}"
                                                           FontSize="16"
                                                           TextAlignment="Center"
                                                           Margin="0,4,0,0"/>
                                                <TextBlock Text="{Binding TotalAmountDisplay}"
                                                           Foreground="{Binding TextBrush}"
                                                           FontSize="17"
                                                           FontWeight="SemiBold"
                                                           TextAlignment="Center"
                                                           Margin="0,4,0,0"
                                                           Visibility="{Binding HasTotalAmount, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            </StackPanel>

                                            <Border Background="White"
                                                    CornerRadius="8"
                                                    Padding="6,2"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Bottom">
                                                <TextBlock Text="{Binding StatusDisplay}"
                                                           Foreground="Black"
                                                           FontSize="12"
                                                           FontWeight="Bold"/>
                                            </Border>

                                            <!-- Icon Provisional Bill (LEFT) -->
                                            <TextBlock Text="🧾"
                                                       FontSize="20"
                                                       HorizontalAlignment="Left"
                                                       VerticalAlignment="Top"
                                                       Margin="5,5,0,0"
                                                       Visibility="{Binding HasProvisionalBill, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock.Effect>
                                                    <DropShadowEffect Color="Black"
                                                                      BlurRadius="2"
                                                                      ShadowDepth="1"
                                                                      Opacity="0.5"/>
                                                </TextBlock.Effect>
                                            </TextBlock>

                                            <!-- Icon Request Payment (RIGHT) -->
                                            <TextBlock Text="🔔"
                                                       FontSize="20"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Top"
                                                       Margin="0,5,5,0"
                                                       Visibility="{Binding IsRequestingPayment, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock.Effect>
                                                    <DropShadowEffect Color="Black"
                                                                      BlurRadius="2"
                                                                      ShadowDepth="1"
                                                                      Opacity="0.5"/>
                                                </TextBlock.Effect>
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <Grid x:Name="pnlMenu"
                          Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0"
                              Margin="15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0"
                                    Content="⬅ CHỌN BÀN KHÁC"
                                    Click="BtnBackToTables_Click"
                                    HorizontalAlignment="Left"
                                    Background="#6c757d"
                                    Foreground="White"
                                    Height="40"
                                    Padding="15,0"
                                    FontWeight="Bold"
                                    BorderThickness="0">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius"
                                                Value="5"/>
                                    </Style>
                                </Button.Resources>
                            </Button>

                            <!-- Search on the same row with title -->
                            <Grid Grid.Column="2"
                                  VerticalAlignment="Center">
                                <Border Background="White"
                                        CornerRadius="8"
                                        MinWidth="240"
                                        MaxWidth="520"
                                        Height="40">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="#D0D7DE"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                    <Setter Property="BorderBrush" Value="#007BFF"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <TextBox x:Name="txtDishSearch"
                                                 Padding="10,0"
                                                 FontSize="14"
                                                 VerticalContentAlignment="Center"
                                                 BorderThickness="0"
                                                 Background="Transparent"
                                                 TextChanged="TxtDishSearch_TextChanged"/>
                                        <TextBlock Text="🔍 Search món (tên hoặc viết tắt)..."
                                                   FontSize="14"
                                                   Foreground="#999"
                                                   Margin="0"
                                                   IsHitTestVisible="False"
                                                   TextAlignment="Center"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Opacity" Value="0"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=txtDishSearch}" Value="">
                                                            <Setter Property="Opacity" Value="0.5"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Text, ElementName=txtDishSearch}" Value="{x:Null}">
                                                            <Setter Property="Opacity" Value="0.5"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </Grid>

                            <StackPanel Grid.Column="4"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                <TextBlock Text="MENU MÓN ĂN"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Foreground="#333"
                                           TextAlignment="Right"/>
                                <TextBlock Text="Chạm vào món để thêm ngay"
                                           FontSize="12"
                                           Foreground="#666"
                                           TextAlignment="Right"/>
                            </StackPanel>
                        </Grid>

                        <ListBox Grid.Row="1"
                                 x:Name="lstCategories"
                                 SelectionChanged="lstCategories_SelectionChanged"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 Height="50"
                                 BorderThickness="0,0,0,1"
                                 Background="Transparent"
                                 Margin="0,0,0,10">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="15,10"
                                            Background="Transparent"
                                            Cursor="Hand"
                                            Margin="2">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                                 Value="True">
                                                        <Setter Property="Background"
                                                                Value="#E3F2FD"/>
                                                        <Setter Property="BorderBrush"
                                                                Value="#2196F3"/>
                                                        <Setter Property="BorderThickness"
                                                                Value="0,0,0,3"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding CategoryName}"
                                                   FontWeight="SemiBold"
                                                   FontSize="14"/>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <ListBox Grid.Row="2"
                                 x:Name="lstDishes"
                                 Padding="10"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.CanContentScroll="True"
                                 ScrollViewer.IsDeferredScrollingEnabled="False"
                                 VirtualizingPanel.ScrollUnit="Pixel">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <helpers:VirtualizingWrapPanel ItemWidth="190"
                                                                   ItemHeight="165"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding"
                                            Value="0"/>
                                    <Setter Property="Margin"
                                            Value="0"/>
                                    <Setter Property="BorderThickness"
                                            Value="0"/>
                                    <Setter Property="Background"
                                            Value="Transparent"/>
                                    <Setter Property="HorizontalContentAlignment"
                                            Value="Stretch"/>
                                    <Setter Property="VerticalContentAlignment"
                                            Value="Stretch"/>
                                    <Setter Property="Focusable"
                                            Value="False"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="178"
                                            Height="150"
                                            Margin="8"
                                            CornerRadius="10"
                                            BorderThickness="2"
                                            BorderBrush="#BFE3FF"
                                            Cursor="Hand"
                                            Background="White"
                                            Tag="{Binding DishID}"
                                            MouseLeftButtonDown="Dish_MouseLeftButtonDown">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Effect"
                                                        Value="{x:Null}"/>
                                                <Setter Property="BorderThickness"
                                                        Value="2"/>
                                                <Setter Property="BorderBrush"
                                                        Value="#BFE3FF"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver"
                                                             Value="True">
                                                        <Setter Property="BorderBrush"
                                                                Value="#7EC3FF"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <!-- Photo background with rounded corners -->
                                            <Border CornerRadius="10"
                                                    Visibility="{Binding ImagePath, Converter={StaticResource DishImagePathToVisibilityConverter}}">
                                                <Border.Background>
                                                    <ImageBrush ImageSource="{Binding ImagePath, Converter={StaticResource DishImagePathToImageSourceConverter}, ConverterParameter=240}"
                                                                Stretch="UniformToFill"
                                                                Opacity="0.95"/>
                                                </Border.Background>
                                            </Border>

                                            <!-- Dark overlay (same rounded corners) -->
                                            <Border CornerRadius="10"
                                                    Visibility="{Binding ImagePath, Converter={StaticResource DishImagePathToVisibilityConverter}}">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0"
                                                                         EndPoint="0,1">
                                                        <GradientStop Color="#20000000"
                                                                      Offset="0"/>
                                                        <GradientStop Color="#A0000000"
                                                                      Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>

                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <Border Grid.Row="0"
                                                        HorizontalAlignment="Stretch"
                                                        VerticalAlignment="Top"
                                                        Margin="10,8,10,0"
                                                        Padding="8,6"
                                                        CornerRadius="8"
                                                        Background="#EFFFFFFF">
                                                    <TextBlock Text="{Binding DishName}"
                                                               TextWrapping="Wrap"
                                                               TextAlignment="Center"
                                                               FontWeight="SemiBold"
                                                               FontSize="18"
                                                               Foreground="#222"/>
                                                </Border>

                                                <Border x:Name="pricePill"
                                                        Grid.Row="1"
                                                        HorizontalAlignment="Center"
                                                        Margin="0,0,0,10"
                                                        Padding="12,6"
                                                        CornerRadius="6"
                                                        Background="#f5f6f8"
                                                        BorderThickness="1">
                                                    <TextBlock Text="{Binding Price, StringFormat={}{0:N0} đ}"
                                                               TextAlignment="Center"
                                                               Foreground="#333"
                                                               FontWeight="Bold"
                                                               FontSize="17"/>
                                                </Border>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="0"
                    Grid.RowSpan="2"
                    Grid.Column="1"
                    Background="White"
                    BorderBrush="#DDD"
                    BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Activity list (moved here from header/left) -->
                    <Border Grid.Row="0"
                            Background="#f1f3f5"
                            BorderBrush="#f1f3f5"
                            BorderThickness="0,0,0,1">
                        <Grid>
                            <ToggleButton x:Name="tglActivityPopup"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Padding="0"
                                          HorizontalContentAlignment="Stretch"
                                          VerticalContentAlignment="Stretch">
                                <ToggleButton.Content>
                                    <StackPanel>
                                        <TextBlock Text="🔔 HOẠT ĐỘNG MỚI"
                                                   FontWeight="Bold"
                                                   Foreground="#495057"
                                                   Margin="0,0,0,4"/>
                                        <!-- Preview list (non-interactive; click opens popup) -->
                                        <ListBox ItemsSource="{Binding NotificationList}"
                                                 Height="45"
                                                 BorderThickness="0"
                                                 Background="Transparent"
                                                 ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="IsHitTestVisible"
                                                            Value="False"/>
                                                    <Setter Property="Focusable"
                                                            Value="False"/>
                                                    <Setter Property="Background"
                                                            Value="Transparent"/>
                                                    <Setter Property="BorderThickness"
                                                            Value="0"/>
                                                    <Setter Property="Padding"
                                                            Value="0"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver"
                                                                 Value="True">
                                                            <Setter Property="Background"
                                                                    Value="Transparent"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected"
                                                                 Value="True">
                                                            <Setter Property="Background"
                                                                    Value="Transparent"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}"
                                                               FontSize="12"
                                                               TextWrapping="Wrap"
                                                               Margin="0,2"
                                                               Foreground="#333"/>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </StackPanel>
                                </ToggleButton.Content>
                            </ToggleButton>

                            <!-- Popup full activity list -->
                            <Popup Placement="Bottom"
                                   PlacementTarget="{Binding ElementName=tglActivityPopup}"
                                   IsOpen="{Binding IsChecked, ElementName=tglActivityPopup, Mode=TwoWay}"
                                   StaysOpen="False"
                                   AllowsTransparency="True">
                                <Border Background="White"
                                        CornerRadius="10"
                                        BorderBrush="#E0E0E0"
                                        BorderThickness="1"
                                        Padding="12"
                                        Width="390">
                                    <Border.Effect>
                                        <DropShadowEffect Color="Black"
                                                          BlurRadius="16"
                                                          ShadowDepth="2"
                                                          Opacity="0.25"/>
                                    </Border.Effect>

                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0"
                                              Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="🔔 HOẠT ĐỘNG MỚI"
                                                       FontWeight="Bold"
                                                       Foreground="#495057"
                                                       VerticalAlignment="Center"/>
                                            <ToggleButton Grid.Column="1"
                                                          IsChecked="{Binding IsChecked, ElementName=tglActivityPopup, Mode=TwoWay}"
                                                          Content="✕"
                                                          Width="28"
                                                          Height="28"
                                                          Background="Transparent"
                                                          BorderThickness="0"
                                                          Foreground="#999"
                                                          FontSize="14"/>
                                        </Grid>

                                        <ListBox Grid.Row="1"
                                                 ItemsSource="{Binding NotificationList}"
                                                 BorderThickness="0"
                                                 Background="Transparent"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                 Height="320">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="IsHitTestVisible"
                                                            Value="False"/>
                                                    <Setter Property="Focusable"
                                                            Value="False"/>
                                                    <Setter Property="Background"
                                                            Value="Transparent"/>
                                                    <Setter Property="BorderThickness"
                                                            Value="0"/>
                                                    <Setter Property="Padding"
                                                            Value="0"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver"
                                                                 Value="True">
                                                            <Setter Property="Background"
                                                                    Value="Transparent"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected"
                                                                 Value="True">
                                                            <Setter Property="Background"
                                                                    Value="Transparent"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}"
                                                               FontSize="13"
                                                               TextWrapping="Wrap"
                                                               Margin="0,4"
                                                               Foreground="#333"/>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Grid>
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1"
                          Background="#6c757d">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Row="0"
                              Grid.Column="0"
                              Grid.ColumnSpan="4"
                              Margin="15,0,15,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="lblSelectedTable"
                                       Grid.Column="0"
                                       Text="Chưa chọn bàn"
                                       Foreground="White"
                                       FontWeight="Bold"
                                       FontSize="20"
                                       HorizontalAlignment="Left"/>
                            <TextBlock x:Name="lblTableTime"
                                       Grid.Column="1"
                                       Text=""
                                       Foreground="#FFEB3B"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Right"/>
                        </Grid>

                        <Button Grid.Row="1"
                                Grid.Column="1"
                                x:Name="btnSplitTable"
                                Content="📤 Tách bàn"
                                Click="BtnSplitTable_Click"
                                Background="#47a67f"
                                Foreground="White"
                                Height="32"
                                Width="120"
                                Margin="5,0"
                                FontWeight="Bold"
                                BorderThickness="0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius"
                                            Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Button Grid.Row="1"
                                Grid.Column="2"
                                x:Name="btnMoveTable"
                                Content="🔄 Chuyển bàn"
                                Click="BtnMoveTable_Click"
                                Background="#47a67f"
                                Foreground="White"
                                Height="32"
                                Width="120"
                                Margin="5,0"
                                FontWeight="Bold"
                                BorderThickness="0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius"
                                            Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Button Grid.Row="1"
                                Grid.Column="3"
                                x:Name="btnReprintKitchen"
                                Visibility="Collapsed"
                                Content="🖨 In lại bếp"
                                Click="BtnReprint_Click"
                                Background="#47a67f"
                                Foreground="White"
                                Height="32"
                                Width="110"
                                Margin="5,0,15,0"
                                FontWeight="Bold"
                                BorderThickness="0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius"
                                            Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>

                    <Grid Grid.Row="2"
                          x:Name="viewOrderDetails"
                          Visibility="Visible">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <DataGrid Grid.Row="0"
                                  x:Name="lstOrderDetails"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  GridLinesVisibility="Horizontal"
                                  HeadersVisibility="Column"
                                  Background="White"
                                  MinRowHeight="55"
                                  FontSize="14"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  ScrollViewer.CanContentScroll="True"
                                  ScrollViewer.IsDeferredScrollingEnabled="False"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  VirtualizingPanel.ScrollUnit="Pixel">
                            <!-- Remove selection highlight (row/cell blue) to keep RowColor readable when clicking rows or focusing note textbox -->
                            <DataGrid.Resources>
                                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"
                                                 Color="Transparent"/>
                                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}"
                                                 Color="Transparent"/>
                                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}"
                                                 Color="Black"/>
                                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}"
                                                 Color="Black"/>
                            </DataGrid.Resources>

                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Background"
                                            Value="{Binding RowColor}"/>
                                    <Setter Property="BorderThickness"
                                            Value="0"/>
                                    <Setter Property="BorderBrush"
                                            Value="Transparent"/>
                                    <Setter Property="FocusVisualStyle"
                                            Value="{x:Null}"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected"
                                                 Value="True">
                                            <Setter Property="Background"
                                                    Value="{Binding RowColor}"/>
                                            <Setter Property="BorderThickness"
                                                    Value="0"/>
                                            <Setter Property="BorderBrush"
                                                    Value="Transparent"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>

                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="BorderThickness"
                                            Value="0"/>
                                    <Setter Property="FocusVisualStyle"
                                            Value="{x:Null}"/>
                                    <Setter Property="Background"
                                            Value="Transparent"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected"
                                                 Value="True">
                                            <Setter Property="Background"
                                                    Value="Transparent"/>
                                            <Setter Property="BorderThickness"
                                                    Value="0"/>
                                        </Trigger>
                                        <Trigger Property="IsKeyboardFocusWithin"
                                                 Value="True">
                                            <Setter Property="BorderThickness"
                                                    Value="0"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.CellStyle>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Món"
                                                        Width="*"
                                                        IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="5,5">
                                                <TextBlock Text="{Binding DishName}"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="Wrap"
                                                           Margin="0,0,0,3"/>

                                                <!-- NOTE RULES (BUGFIX):
                                                       - Chỉ món CHƯA gửi bếp (ItemStatus=New) mới được nhập/sửa ghi chú.
                                                       - Món ĐÃ gửi bếp hoặc ĐANG cập nhật (Sent/Modified): chỉ hiển thị ghi chú nếu có; không cho sửa.
                                                        (Tránh lỗi: giảm số lượng sau gửi bếp rồi nhập ghi chú sẽ dính vào món còn lại.) -->
                                                <Border x:Name="noteBorder"
                                                        CornerRadius="4"
                                                        Padding="4"
                                                        Background="#FFF3CD"
                                                        BorderBrush="#FFEEBA"
                                                        BorderThickness="1">
                                                    <Grid>
                                                        <!-- Editable note input (white background + thin green border) -->
                                                        <Border x:Name="noteInputBorder"
                                                                Background="White"
                                                                BorderBrush="#28A745"
                                                                BorderThickness="1"
                                                                CornerRadius="3"
                                                                Padding="4">
                                                            <Grid>
                                                                <TextBox x:Name="txtNoteEdit"
                                                                         Text="{Binding Note, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                         Tag="{Binding OrderDetailID}"
                                                                         LostFocus="TxtNote_LostFocus"
                                                                         Padding="0,2"
                                                                         TextWrapping="Wrap"
                                                                         AcceptsReturn="True"
                                                                         Background="Transparent"
                                                                         BorderThickness="0">
                                                                    <TextBox.Style>
                                                                        <Style TargetType="TextBox"
                                                                               BasedOn="{StaticResource NoteTextBoxStyle}">
                                                                            <Setter Property="IsReadOnly"
                                                                                    Value="False"/>
                                                                            <Setter Property="ToolTip"
                                                                                    Value="Nhập ghi chú (Ví dụ: Ít đường...)"/>
                                                                        </Style>
                                                                    </TextBox.Style>
                                                                </TextBox>

                                                                <!-- Placeholder only for editable mode -->
                                                                <TextBlock x:Name="txtNotePlaceholder"
                                                                           Text="Ghi chú"
                                                                           FontSize="12"
                                                                           Foreground="#8A6D3B"
                                                                           FontStyle="Italic"
                                                                           Margin="5,2"
                                                                           IsHitTestVisible="False"
                                                                           VerticalAlignment="Center"
                                                                           Visibility="{Binding Note, Converter={StaticResource EmptyStringToVisibilityConverter}}"/>
                                                            </Grid>
                                                        </Border>

                                                        <!-- Read-only note display for Sent/Modified items (only shown when note exists) -->
                                                        <TextBlock x:Name="txtNoteDisplay"
                                                                   Visibility="Collapsed"
                                                                   TextWrapping="Wrap"
                                                                   FontSize="12"
                                                                   Foreground="#495057">
                                                            <Run Text="📝 "/>
                                                            <Run Text="{Binding Note}"/>
                                                        </TextBlock>
                                                    </Grid>
                                                </Border>
                                            </StackPanel>

                                            <DataTemplate.Triggers>
                                                <!-- Sent: show note only if it exists, hide editor -->
                                                <DataTrigger Binding="{Binding ItemStatus}"
                                                             Value="Sent">
                                                    <Setter TargetName="noteBorder"
                                                            Property="Background"
                                                            Value="Transparent"/>
                                                    <Setter TargetName="noteBorder"
                                                            Property="BorderThickness"
                                                            Value="0"/>
                                                    <Setter TargetName="noteBorder"
                                                            Property="Padding"
                                                            Value="0"/>
                                                    <Setter TargetName="txtNoteEdit"
                                                            Property="Visibility"
                                                            Value="Collapsed"/>
                                                    <Setter TargetName="noteInputBorder"
                                                            Property="Visibility"
                                                            Value="Collapsed"/>
                                                    <Setter TargetName="txtNotePlaceholder"
                                                            Property="Visibility"
                                                            Value="Collapsed"/>
                                                    <Setter TargetName="txtNoteDisplay"
                                                            Property="Visibility"
                                                            Value="Visible"/>
                                                </DataTrigger>

                                                <!-- Modified: treat like Sent (read-only) to avoid note leaking to remaining sent items -->
                                                <DataTrigger Binding="{Binding ItemStatus}"
                                                             Value="Modified">
                                                    <Setter TargetName="noteBorder"
                                                            Property="Background"
                                                            Value="Transparent"/>
                                                    <Setter TargetName="noteBorder"
                                                            Property="BorderThickness"
                                                            Value="0"/>
                                                    <Setter TargetName="noteBorder"
                                                            Property="Padding"
                                                            Value="0"/>
                                                    <Setter TargetName="txtNoteEdit"
                                                            Property="Visibility"
                                                            Value="Collapsed"/>
                                                    <Setter TargetName="noteInputBorder"
                                                            Property="Visibility"
                                                            Value="Collapsed"/>
                                                    <Setter TargetName="txtNotePlaceholder"
                                                            Property="Visibility"
                                                            Value="Collapsed"/>
                                                    <Setter TargetName="txtNoteDisplay"
                                                            Property="Visibility"
                                                            Value="Visible"/>
                                                </DataTrigger>

                                                <!-- Sent + empty note => hide note area entirely -->
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding ItemStatus}"
                                                                   Value="Sent"/>
                                                        <Condition Binding="{Binding Note}"
                                                                   Value=""/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter TargetName="noteBorder"
                                                            Property="Visibility"
                                                            Value="Collapsed"/>
                                                </MultiDataTrigger>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding ItemStatus}"
                                                                   Value="Sent"/>
                                                        <Condition Binding="{Binding Note}"
                                                                   Value="{x:Null}"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter TargetName="noteBorder"
                                                            Property="Visibility"
                                                            Value="Collapsed"/>
                                                </MultiDataTrigger>

                                                <!-- Modified + empty note => hide note area entirely -->
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding ItemStatus}"
                                                                   Value="Modified"/>
                                                        <Condition Binding="{Binding Note}"
                                                                   Value=""/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter TargetName="noteBorder"
                                                            Property="Visibility"
                                                            Value="Collapsed"/>
                                                </MultiDataTrigger>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding ItemStatus}"
                                                                   Value="Modified"/>
                                                        <Condition Binding="{Binding Note}"
                                                                   Value="{x:Null}"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter TargetName="noteBorder"
                                                            Property="Visibility"
                                                            Value="Collapsed"/>
                                                </MultiDataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Đợt"
                                                    Binding="{Binding BatchDisplay}"
                                                    Width="50"
                                                    IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment"
                                                    Value="Center"/>
                                            <Setter Property="VerticalAlignment"
                                                    Value="Center"/>
                                            <Setter Property="FontStyle"
                                                    Value="Italic"/>
                                            <Setter Property="Foreground"
                                                    Value="Gray"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTemplateColumn Header="SL"
                                                        Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        x:Name="pnlQuantityControls">
                                                <Button Content="-"
                                                        Click="BtnDecrease_Click"
                                                        Tag="{Binding OrderDetailID}"
                                                        Width="30"
                                                        Height="30"
                                                        Background="#F8F9FA"
                                                        BorderBrush="#DEE2E6"
                                                        BorderThickness="1"
                                                        FontWeight="Bold"
                                                        Foreground="#DC3545"
                                                        Cursor="Hand"
                                                        Margin="0,0,5,0"
                                                        x:Name="btnDecreaseControl"/>
                                                <TextBlock x:Name="txtQuantityDisplay"
                                                           Text="{Binding Quantity}"
                                                           Width="30"
                                                           TextAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           FontWeight="Bold"
                                                           FontSize="16"/>
                                                <Button Content="+"
                                                        Click="BtnIncrease_Click"
                                                        Tag="{Binding OrderDetailID}"
                                                        Width="30"
                                                        Height="30"
                                                        Background="#F8F9FA"
                                                        BorderBrush="#DEE2E6"
                                                        BorderThickness="1"
                                                        FontWeight="Bold"
                                                        Foreground="#28A745"
                                                        Cursor="Hand"
                                                        Margin="5,0,0,0"
                                                        x:Name="btnIncreaseControl"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Giá gốc"
                                                    Binding="{Binding UnitPrice, StringFormat={}{0:N0}}"
                                                    Width="70"
                                                    IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment"
                                                    Value="Right"/>
                                            <Setter Property="VerticalAlignment"
                                                    Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTemplateColumn Header="Tiền ✎"
                                                        Width="75">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Click="BtnEditItem_Click"
                                                    Tag="{Binding OrderDetailID}"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Padding="0"
                                                    HorizontalContentAlignment="Right"
                                                    VerticalContentAlignment="Center"
                                                    Cursor="Hand"
                                                    ToolTip="Nhấn để điều chỉnh giá món">
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding TotalAmount, StringFormat={}{0:N0}}"
                                                               FontWeight="Bold"
                                                               HorizontalAlignment="Right"/>
                                                    <TextBlock Text="{Binding DiscountDisplay}"
                                                               FontSize="10"
                                                               Foreground="Red"
                                                               HorizontalAlignment="Right"
                                                               Visibility="{Binding HasDiscount, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Grid.Row="1"
                                    Margin="15,5,15,5">
                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0"
                                            Orientation="Horizontal">
                                    <Button x:Name="btnDiscountBill"
                                            Content="🎫 Giảm Bill"
                                            HorizontalAlignment="Left"
                                            Height="34"
                                            Padding="12,4"
                                            Background="#47a67f"
                                            Foreground="White"
                                            FontWeight="SemiBold"
                                            BorderThickness="0"
                                            IsEnabled="False"
                                            Click="BtnDiscountBill_Click">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius"
                                                        Value="5"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </StackPanel>
                                <StackPanel Grid.Column="1"
                                            HorizontalAlignment="Right">
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Right">
                                        <TextBlock Text="Tổng (gốc): "
                                                   FontSize="14"/>
                                        <TextBlock x:Name="lblSubTotal"
                                                   Text="0đ"
                                                   FontWeight="Bold"
                                                   FontSize="14"/>
                                    </StackPanel>

                                    <!-- [NEW] Item Adjustments Display -->
                                    <StackPanel x:Name="pnlAdjustment"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                Visibility="Collapsed">
                                        <TextBlock x:Name="lblAdjustmentTitle"
                                                   Text="Chênh lệch món: "
                                                   Foreground="#FD7E14"
                                                   FontSize="14"/>
                                        <TextBlock x:Name="lblAdjustment"
                                                   Text="+0đ"
                                                   FontWeight="Bold"
                                                   Foreground="#FD7E14"
                                                   FontSize="14"/>
                                    </StackPanel>
                                    <StackPanel x:Name="pnlDiscount"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                Visibility="Collapsed">
                                        <TextBlock Text="Giảm: "
                                                   Foreground="Red"/>
                                        <TextBlock x:Name="lblDiscount"
                                                   Text="-0đ"
                                                   FontWeight="Bold"
                                                   Foreground="Red"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                Margin="0,5,0,0">
                                        <TextBlock Text="KHÁCH TRẢ: "
                                                   FontSize="18"
                                                   FontWeight="Bold"/>
                                        <TextBlock x:Name="lblTotal"
                                                   Text="0đ"
                                                   FontSize="20"
                                                   FontWeight="Bold"
                                                   Foreground="#28A745"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>

                            <!-- SendKitchen + Provisional + Checkout layout -->
                            <Grid Margin="0,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <Button x:Name="btnSendKitchen"
                                            Content="👨‍🍳 GỬI BẾP"
                                            Height="44"
                                            Background="#fff3cd"
                                            Foreground="Black"
                                            FontSize="14"
                                            FontWeight="Bold"
                                            Click="BtnSendKitchen_Click"/>
                                    <Button x:Name="btnProvisional"
                                            Content="🖨 IN TẠM TÍNH"
                                            Height="44"
                                            Margin="0,8,0,0"
                                            Background="#A7D3F5"
                                            Foreground="Black"
                                            FontSize="14"
                                            FontWeight="Bold"
                                            Click="BtnPrintProvisional_Click"/>
                                </StackPanel>

                                <Button Grid.Column="2"
                                        x:Name="btnCheckout"
                                        Content="THANH TOÁN"
                                        Height="96"
                                        Foreground="Black"
                                        Background="#d4edda"
                                        FontSize="15"
                                        FontWeight="Bold"
                                        IsEnabled="False"
                                        Click="btnCheckout_Click"/>
                            </Grid>
                        </StackPanel>

                        <Border x:Name="bdToast"
                                Background="#CC28A745"
                                CornerRadius="20"
                                VerticalAlignment="Bottom"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,130"
                                Padding="20,10"
                                Visibility="Collapsed"
                                IsHitTestVisible="False"
                                Panel.ZIndex="999">
                            <TextBlock x:Name="lblToastMessage"
                                       Text="Đã thêm món"
                                       Foreground="White"
                                       FontWeight="Bold"
                                       FontSize="14"/>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Reprint Popup Overlay -->
        <Grid x:Name="pnlReprintPopup"
              Visibility="Collapsed"
              Panel.ZIndex="1000">
            <Border Background="#99000000"
                    MouseLeftButtonDown="PnlReprintPopup_OutsideClick"/>
            <Border Width="500"
                    Height="600"
                    Background="White"
                    CornerRadius="12"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Padding="0">
                <Border.Effect>
                    <DropShadowEffect Color="Black"
                                      BlurRadius="20"
                                      ShadowDepth="0"
                                      Opacity="0.4"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="60"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="70"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Border Grid.Row="0"
                            BorderThickness="0,0,0,1"
                            BorderBrush="#EEE"
                            Padding="20,0"
                            Background="#F8F9FA"
                            CornerRadius="12,12,0,0">
                        <Grid>
                            <TextBlock Text="🖨 CHỌN MÓN IN LẠI"
                                       FontWeight="Bold"
                                       FontSize="18"
                                       VerticalAlignment="Center"
                                       Foreground="#333"/>
                            <Button Content="✕"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Width="30"
                                    Height="30"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    FontSize="16"
                                    Foreground="#999"
                                    Click="BtnCloseReprintPopup_Click"
                                    Cursor="Hand"/>
                        </Grid>
                    </Border>

                    <!-- Select All -->
                    <Border Grid.Row="1"
                            Padding="15,10"
                            BorderThickness="0,0,0,1"
                            BorderBrush="#F0F0F0">
                        <Button x:Name="btnSelectAllReprint"
                                Content="Chọn tất cả"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Click="BtnSelectAllReprint_Click"
                                HorizontalAlignment="Left"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="#007BFF"
                                Cursor="Hand"/>
                    </Border>

                    <!-- List Items -->
                    <ScrollViewer Grid.Row="2"
                                  VerticalScrollBarVisibility="Auto"
                                  Padding="10">
                        <ItemsControl x:Name="lstReprintItems">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="10"
                                            Margin="5"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            MouseLeftButtonDown="ReprintItem_Click"
                                            Cursor="Hand">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background"
                                                        Value="White"/>
                                                <Setter Property="BorderBrush"
                                                        Value="#EEE"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}"
                                                                 Value="True">
                                                        <Setter Property="Background"
                                                                Value="#E3F2FD"/>
                                                        <!-- Use a stronger blue for visibility -->
                                                        <Setter Property="BorderBrush"
                                                                Value="#007BFF"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayText}"
                                                           FontWeight="Bold"
                                                           FontSize="15"
                                                           Foreground="#333"/>
                                                <TextBlock Text="{Binding Note}"
                                                           FontSize="13"
                                                           Foreground="#666"
                                                           FontStyle="Italic"
                                                           Visibility="{Binding Note, Converter={StaticResource NotEmptyStringToVisibilityConverter}}"/>
                                            </StackPanel>

                                            <Border Grid.Column="1"
                                                    Background="#E3F2FD"
                                                    CornerRadius="4"
                                                    Padding="0">
                                                <StackPanel Orientation="Horizontal"
                                                            VerticalAlignment="Center">
                                                    <!-- Decrease Button -->
                                                    <Button Width="30"
                                                            Height="30"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Content="-"
                                                            FontWeight="Bold"
                                                            Foreground="#007BFF"
                                                            FontSize="16"
                                                            Cursor="Hand"
                                                            Click="BtnDecreaseReprint_Click"
                                                            IsEnabled="{Binding IsSelected}">
                                                        <Button.Resources>
                                                            <Style TargetType="Border">
                                                                <Setter Property="CornerRadius"
                                                                        Value="4"/>
                                                            </Style>
                                                        </Button.Resources>
                                                    </Button>

                                                    <!-- Quantity Text -->
                                                    <TextBlock Text="{Binding QuantityDisplay}"
                                                               FontWeight="Bold"
                                                               Foreground="#007BFF"
                                                               VerticalAlignment="Center"
                                                               Margin="5,0"
                                                               MinWidth="40"
                                                               TextAlignment="Center"/>

                                                    <!-- Increase Button -->
                                                    <Button Width="30"
                                                            Height="30"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Content="+"
                                                            FontWeight="Bold"
                                                            Foreground="#007BFF"
                                                            FontSize="16"
                                                            Cursor="Hand"
                                                            Click="BtnIncreaseReprint_Click"
                                                            IsEnabled="{Binding IsSelected}">
                                                        <Button.Resources>
                                                            <Style TargetType="Border">
                                                                <Setter Property="CornerRadius"
                                                                        Value="4"/>
                                                            </Style>
                                                        </Button.Resources>
                                                    </Button>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Footer -->
                    <Border Grid.Row="3"
                            BorderThickness="0,1,0,0"
                            BorderBrush="#EEE"
                            Background="#F8F9FA"
                            CornerRadius="0,0,12,12"
                            Padding="20,0">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <Button Content="Hủy bỏ"
                                    Click="BtnCloseReprintPopup_Click"
                                    Width="100"
                                    Height="40"
                                    Background="White"
                                    BorderBrush="#DDD"
                                    BorderThickness="1"
                                    Foreground="#666"
                                    FontWeight="SemiBold"
                                    Margin="0,0,10,0"
                                    Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius"
                                                Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                            <Button Content="🖨 In lại ngay"
                                    Click="BtnConfirmReprint_Click"
                                    Width="140"
                                    Height="40"
                                    Background="#6F42C1"
                                    BorderThickness="0"
                                    Foreground="White"
                                    FontWeight="Bold"
                                    Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius"
                                                Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Split Table Popup -->
        <Grid x:Name="pnlSplitPopup"
              Visibility="Collapsed"
              Panel.ZIndex="1000">
            <Border Background="Black"
                    Opacity="0.5"
                    MouseDown="PnlSplitPopup_OutsideClick"/>
            <Border Width="500"
                    Height="600"
                    Background="White"
                    CornerRadius="12"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect Color="Black"
                                      BlurRadius="20"
                                      ShadowDepth="0"
                                      Opacity="0.4"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="60"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="70"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Border Grid.Row="0"
                            BorderThickness="0,0,0,1"
                            BorderBrush="#EEE"
                            Padding="20,0"
                            Background="#F8F9FA"
                            CornerRadius="12,12,0,0">
                        <Grid>
                            <TextBlock Text="📤 TÁCH BÀN - CHỌN MÓN"
                                       FontWeight="Bold"
                                       FontSize="18"
                                       VerticalAlignment="Center"
                                       Foreground="#333"/>
                            <Button Content="✕"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Width="30"
                                    Height="30"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    FontSize="16"
                                    Foreground="#999"
                                    Click="BtnCloseSplitPopup_Click"
                                    Cursor="Hand"/>
                        </Grid>
                    </Border>

                    <!-- Select All -->
                    <Border Grid.Row="1"
                            Padding="15,10"
                            BorderThickness="0,0,0,1"
                            BorderBrush="#F0F0F0">
                        <Button x:Name="btnSelectAllSplit"
                                Content="Chọn tất cả"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Click="BtnSelectAllSplit_Click"
                                HorizontalAlignment="Left"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="#007BFF"
                                Cursor="Hand"/>
                    </Border>

                    <!-- List Items -->
                    <ScrollViewer Grid.Row="2"
                                  VerticalScrollBarVisibility="Auto"
                                  Padding="10">
                        <ItemsControl x:Name="lstSplitItems">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="10"
                                            Margin="5"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            MouseLeftButtonDown="ReprintItem_Click"
                                            Cursor="Hand">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background"
                                                        Value="White"/>
                                                <Setter Property="BorderBrush"
                                                        Value="#EEE"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}"
                                                                 Value="True">
                                                        <Setter Property="Background"
                                                                Value="#E3F2FD"/>
                                                        <Setter Property="BorderBrush"
                                                                Value="#007BFF"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayText}"
                                                           FontWeight="Bold"
                                                           FontSize="15"
                                                           Foreground="#333"/>
                                                <TextBlock Text="{Binding Note}"
                                                           FontSize="13"
                                                           Foreground="#666"
                                                           FontStyle="Italic"
                                                           Visibility="{Binding Note, Converter={StaticResource NotEmptyStringToVisibilityConverter}}"/>
                                            </StackPanel>

                                            <Border Grid.Column="1"
                                                    Background="#E3F2FD"
                                                    CornerRadius="4"
                                                    Padding="0">
                                                <StackPanel Orientation="Horizontal"
                                                            VerticalAlignment="Center">
                                                    <!-- Decrease Button -->
                                                    <Button Width="30"
                                                            Height="30"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Content="-"
                                                            FontWeight="Bold"
                                                            Foreground="#007BFF"
                                                            FontSize="16"
                                                            Cursor="Hand"
                                                            Click="BtnDecreaseReprint_Click"
                                                            IsEnabled="{Binding IsSelected}">
                                                        <Button.Resources>
                                                            <Style TargetType="Border">
                                                                <Setter Property="CornerRadius"
                                                                        Value="4"/>
                                                            </Style>
                                                        </Button.Resources>
                                                    </Button>

                                                    <!-- Quantity Text -->
                                                    <TextBlock Text="{Binding QuantityDisplay}"
                                                               FontWeight="Bold"
                                                               Foreground="#007BFF"
                                                               VerticalAlignment="Center"
                                                               Margin="5,0"
                                                               MinWidth="40"
                                                               TextAlignment="Center"/>

                                                    <!-- Increase Button -->
                                                    <Button Width="30"
                                                            Height="30"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Content="+"
                                                            FontWeight="Bold"
                                                            Foreground="#007BFF"
                                                            FontSize="16"
                                                            Cursor="Hand"
                                                            Click="BtnIncreaseReprint_Click"
                                                            IsEnabled="{Binding IsSelected}">
                                                        <Button.Resources>
                                                            <Style TargetType="Border">
                                                                <Setter Property="CornerRadius"
                                                                        Value="4"/>
                                                            </Style>
                                                        </Button.Resources>
                                                    </Button>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Footer -->
                    <Border Grid.Row="3"
                            BorderThickness="0,1,0,0"
                            BorderBrush="#EEE"
                            Background="#F8F9FA"
                            CornerRadius="0,0,12,12"
                            Padding="20,0">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <Button Content="Hủy bỏ"
                                    Click="BtnCloseSplitPopup_Click"
                                    Width="100"
                                    Height="40"
                                    Background="White"
                                    BorderBrush="#DDD"
                                    BorderThickness="1"
                                    Foreground="#666"
                                    FontWeight="SemiBold"
                                    Margin="0,0,10,0"
                                    Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius"
                                                Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                            <Button Content="➡ Chọn bàn đến"
                                    Click="BtnConfirmSplit_Click"
                                    Width="150"
                                    Height="40"
                                    Background="#28A745"
                                    BorderThickness="0"
                                    Foreground="White"
                                    FontWeight="Bold"
                                    Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius"
                                                Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>