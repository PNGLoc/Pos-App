<Window x:Class="PosSystem.Main.DiscountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Điều chỉnh giá"
        Height="300"
        Width="350"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="White"
        BorderBrush="#007BFF"
        BorderThickness="1">

    <Window.Resources>
        <!-- Style cho TabItem để trông to và dễ bấm -->
        <Style TargetType="TabItem">
            <Setter Property="FontSize"
                    Value="16"/>
            <Setter Property="FontWeight"
                    Value="Bold"/>
            <Setter Property="Padding"
                    Value="10"/>
            <Setter Property="Height"
                    Value="40"/>
        </Style>

        <!-- Toggle Button Style for RadioButton -->
        <Style x:Key="ToggleButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#666"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" TargetName="border" Value="#007BFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toggle Mode: GIẢM GIÁ vs TĂNG GIÁ -->
        <Border x:Name="pnlToggleMode" Grid.Row="0" Margin="0,0,0,10" BorderBrush="#EEE" BorderThickness="1" CornerRadius="5" Padding="2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <RadioButton x:Name="optDecrease" Content="📉 GIẢM GIÁ" 
                             Grid.Column="0" IsChecked="True"
                             Style="{StaticResource ToggleButtonStyle}"
                             Click="OptMode_Click"/>

                <RadioButton x:Name="optIncrease" Content="📈 TĂNG GIÁ" 
                             Grid.Column="1"
                             Style="{StaticResource ToggleButtonStyle}"
                             Click="OptMode_Click"/>
            </Grid>
        </Border>

        <!-- Tab chuyển đổi -->
        <TabControl Grid.Row="1"
                x:Name="tabMain">
            <!-- TAB 1: THEO PHẦN TRĂM -->
            <TabItem Header="Theo %">
                <StackPanel VerticalAlignment="Center"
                        Margin="10">
                    <TextBlock Text="Nhập % giảm:"
                            Foreground="#666"
                            Margin="0,0,0,5"/>
                    <TextBox x:Name="txtPercent"
                            Height="40"
                            FontSize="20"
                            FontWeight="Bold"
                             HorizontalContentAlignment="Center"
                            Text="0"
                             PreviewTextInput="NumberValidationTextBox"
                            GotFocus="Txt_GotFocus"/>
                    <TextBlock Text="(Nhập số dương để giảm, số âm để tăng giá)"
                            FontSize="11"
                            Foreground="#999"
                            HorizontalAlignment="Center"
                            Margin="0,5,0,0"/>
                </StackPanel>
            </TabItem>

            <!-- TAB 2: THEO SỐ TIỀN / GIÁ MỚI -->
            <TabItem Header="Theo Giá Tiền">
                <StackPanel VerticalAlignment="Center"
                        Margin="10">
                    <TextBlock x:Name="lblCashTitle"
                            Text="Nhập số tiền:"
                            Foreground="#666"
                            Margin="0,0,0,5"/>
                    <TextBox x:Name="txtAmount"
                            Height="40"
                            FontSize="20"
                            FontWeight="Bold"
                             HorizontalContentAlignment="Center"
                            Text="0"
                             PreviewTextInput="NumberValidationTextBox"
                            GotFocus="Txt_GotFocus"
                            TextChanged="TxtAmount_TextChanged"/>
                    <TextBlock Text="(Nhập thẳng giá bán mới hoặc số tiền giảm)"
                            FontSize="11"
                            Foreground="#999"
                            HorizontalAlignment="Center"
                            Margin="0,5,0,0"/>
                </StackPanel>
            </TabItem>
        </TabControl>

        <!-- Nút bấm -->
        <StackPanel Grid.Row="2"
                Orientation="Horizontal"
                HorizontalAlignment="Center"
                Margin="0,15,0,5">
            <Button Content="Hủy bỏ"
                    Width="100"
                    Height="40"
                    Margin="0,0,10,0"
                    Click="BtnCancel_Click"
                    Background="#EEE"/>
            <Button Content="XÁC NHẬN"
                    Width="120"
                    Height="40"
                    Background="#007BFF"
                    Foreground="White"
                    FontWeight="Bold"
                    Click="BtnOK_Click"
                    IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>