<Window x:Class="PosSystem.Main.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PosSystem.Main"
        Title="Order History"
        Height="700"
        Width="1050"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <local:EmptyStringToVisibilityConverter x:Key="EmptyStringToVisibilityConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background"
                    Value="#F1F3F5"/>
            <Setter Property="Foreground"
                    Value="#495057"/>
            <Setter Property="FontWeight"
                    Value="Bold"/>
            <Setter Property="Padding"
                    Value="10,12"/>
            <Setter Property="BorderThickness"
                    Value="0,0,0,1"/>
            <Setter Property="BorderBrush"
                    Value="#DEE2E6"/>
        </Style>
    </Window.Resources>

    <Border Background="White"
            CornerRadius="12"
            BorderBrush="#CED4DA"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="Black"
                              BlurRadius="20"
                              ShadowDepth="0"
                              Opacity="0.25"/>
        </Border.Effect>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="🕒"
                               FontSize="24"
                               Margin="0,0,10,0"/>
                    <TextBlock Text="NHẬT KÝ HOẠT ĐỘNG"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#0CA678"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <Button HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Click="BtnClose_Click"
                        Width="30"
                        Height="30"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand">
                    <TextBlock Text="✕"
                               FontSize="16"
                               Foreground="#868E96"
                               FontWeight="Bold"/>
                </Button>
            </Grid>

            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        Margin="0,0,0,15">
                <TextBlock Text="Xem ngày:"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Margin="0,0,10,0"/>
                <DatePicker x:Name="dpDate"
                            Width="140"
                            SelectedDateChanged="DpDate_SelectedDateChanged"
                            VerticalContentAlignment="Center"
                            Padding="5"/>
            </StackPanel>

            <TabControl Grid.Row="2"
                        x:Name="tabHistory"
                        Background="Transparent"
                        BorderThickness="0"
                        SelectedIndex="0">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="FontSize"
                                Value="14"/>
                        <Setter Property="FontWeight"
                                Value="SemiBold"/>
                        <Setter Property="Padding"
                                Value="15,10"/>
                        <Setter Property="Cursor"
                                Value="Hand"/>
                    </Style>
                </TabControl.Resources>

                <TabItem Header="Danh sách Hóa đơn">
                    <DataGrid x:Name="dgOrders"
                              Margin="0,10,0,0"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              Background="White"
                              RowHeight="45"
                              FontSize="14"
                              GridLinesVisibility="Horizontal"
                              BorderThickness="1"
                              BorderBrush="#DEE2E6">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID"
                                                Binding="{Binding OrderID}"
                                                Width="60"
                                                FontWeight="Bold"/>
                            <DataGridTextColumn Header="Giờ thanh toán"
                                                Binding="{Binding CheckoutTimeDisplay}"
                                                SortMemberPath="CheckoutTime"
                                                Width="120"/>
                            <DataGridTextColumn Header="Giờ vào"
                                                Binding="{Binding OrderTimeDisplay}"
                                                SortMemberPath="OrderTime"
                                                Width="100"/>
                            <DataGridTextColumn Header="Bàn"
                                                Binding="{Binding TableName}"
                                                Width="100"/>
                            <DataGridTextColumn Header="Tổng tiền"
                                                Binding="{Binding TotalAmount, StringFormat={}{0:N0}}"
                                                Width="120"
                                                FontWeight="Bold">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment"
                                                Value="Right"/>
                                        <Setter Property="Padding"
                                                Value="0,0,15,0"/>
                                        <Setter Property="Foreground"
                                                Value="#28A745"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Thu ngân"
                                                Binding="{Binding StaffName}"
                                                Width="150"/>

                            <DataGridTemplateColumn Header="Trạng thái"
                                                    Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding StatusColor}"
                                                CornerRadius="12"
                                                Padding="10,4"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding StatusDisplay}"
                                                       Foreground="White"
                                                       FontSize="11"
                                                       FontWeight="Bold"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Thao tác"
                                                    Width="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="👁 Chi tiết"
                                                    Click="BtnViewDetail_Click"
                                                    Tag="{Binding OrderID}"
                                                    Background="#17A2B8"
                                                    Foreground="White"
                                                    FontWeight="Bold"
                                                    Padding="8,5"
                                                    BorderThickness="0"
                                                    Cursor="Hand"
                                                    Margin="0,0,5,0">
                                                <Button.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius"
                                                                Value="4"/>
                                                    </Style>
                                                </Button.Resources>
                                            </Button>
                                            <Button Content="🖨 In lại"
                                                    Click="BtnReprint_Click"
                                                    Tag="{Binding OrderID}"
                                                    Background="#6C757D"
                                                    Foreground="White"
                                                    FontWeight="Bold"
                                                    Padding="8,5"
                                                    BorderThickness="0"
                                                    Cursor="Hand">
                                                <Button.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius"
                                                                Value="4"/>
                                                    </Style>
                                                </Button.Resources>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <TabItem Header="Lịch sử Order (Chi tiết)">
                    <DataGrid x:Name="dgItems"
                              Margin="0,10,0,0"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              Background="White"
                              RowHeight="50"
                              FontSize="14"
                              GridLinesVisibility="Horizontal"
                              BorderThickness="1"
                              BorderBrush="#DEE2E6">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Thời gian"
                                                Binding="{Binding TimeDisplay}"
                                                Width="90"/>

                            <DataGridTextColumn Header="Bàn"
                                                Binding="{Binding TableName}"
                                                Width="80"
                                                FontWeight="Bold"/>

                            <DataGridTextColumn Header="Món ăn"
                                                Binding="{Binding DishName}"
                                                Width="160"
                                                FontWeight="SemiBold"/>

                            <DataGridTextColumn Header="Ghi chú"
                                                Binding="{Binding Note}"
                                                Width="*"
                                                FontStyle="Italic"
                                                Foreground="#666"/>

                            <DataGridTextColumn Header="SL"
                                                Binding="{Binding Quantity}"
                                                Width="60">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment"
                                                Value="Center"/>
                                        <Setter Property="FontWeight"
                                                Value="Bold"/>
                                        <Setter Property="FontSize"
                                                Value="16"/>
                                        <Setter Property="Foreground"
                                                Value="#007BFF"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Người gọi"
                                                Binding="{Binding StaffName}"
                                                Width="120"/>

                            <DataGridTemplateColumn Header="Trạng thái"
                                                    Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding StatusBg}"
                                                CornerRadius="4"
                                                Padding="5"
                                                HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding StatusDisplay}"
                                                       Foreground="{Binding StatusFore}"
                                                       FontWeight="Bold"
                                                       FontSize="12"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <TabItem Header="Lịch sử hủy món">
                    <DataGrid x:Name="dgCancelledLogs"
                              Margin="0,10,0,0"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              Background="White"
                              RowHeight="45"
                              FontSize="14"
                              GridLinesVisibility="Horizontal"
                              BorderThickness="1"
                              BorderBrush="#DEE2E6">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Thời gian"
                                                Binding="{Binding LogTime, StringFormat='HH:mm'}"
                                                Width="80"/>
                            <DataGridTextColumn Header="Bàn"
                                                Binding="{Binding TableName}"
                                                Width="100"/>
                            <DataGridTextColumn Header="Tên món"
                                                Binding="{Binding DishName}"
                                                Width="150"
                                                FontWeight="SemiBold"/>
                            <DataGridTextColumn Header="SL"
                                                Binding="{Binding Quantity}"
                                                Width="60"
                                                FontWeight="Bold"/>
                            <DataGridTextColumn Header="Giá trị"
                                                Binding="{Binding Amount, StringFormat={}{0:N0}}"
                                                Width="100"/>
                            <DataGridTextColumn Header="Người hủy"
                                                Binding="{Binding DeletedBy}"
                                                Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
            </TabControl>

            <Grid x:Name="pnlOrderDetailPopup"
                  Visibility="Collapsed"
                  Grid.Row="0"
                  Grid.RowSpan="3"
                  Panel.ZIndex="999">
                <Border Background="Black"
                        Opacity="0.4"
                        MouseLeftButtonDown="BtnCloseDetail_Click"/>

                <Border Background="White"
                        Width="600"
                        Height="500"
                        CornerRadius="10"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Padding="20">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="20"
                                          ShadowDepth="0"
                                          Opacity="0.3"/>
                    </Border.Effect>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0"
                              Margin="0,0,0,15">
                            <StackPanel>
                                <TextBlock x:Name="lblPopupTitle"
                                           Text="CHI TIẾT HÓA ĐƠN"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="#333"/>
                                <TextBlock x:Name="lblPopupInfo"
                                           Text="..."
                                           FontSize="14"
                                           Foreground="#666"/>
                            </StackPanel>
                            <Button HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Click="BtnCloseDetail_Click"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand">
                                <TextBlock Text="✕"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="Gray"/>
                            </Button>
                        </Grid>

                        <DataGrid Grid.Row="1"
                                  x:Name="dgPopupDetails"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  Background="White"
                                  RowHeight="40"
                                  GridLinesVisibility="Horizontal"
                                  BorderBrush="#EEE"
                                  BorderThickness="1">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Tên món"
                                                        Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Text="{Binding DishName}"/>
                                                <TextBlock Text="{Binding DiscountDisplay}"
                                                           FontSize="11"
                                                           Foreground="#C0392B"
                                                           FontStyle="Italic"
                                                           Visibility="{Binding HasDiscount, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Đơn giá"
                                                    Binding="{Binding UnitPrice, StringFormat={}{0:N0}}"
                                                    Width="90"/>
                                <DataGridTextColumn Header="SL"
                                                    Binding="{Binding Quantity}"
                                                    Width="50"
                                                    FontWeight="Bold"/>
                                <DataGridTextColumn Header="Thành tiền"
                                                    Binding="{Binding TotalAmount, StringFormat={}{0:N0}}"
                                                    Width="100"
                                                    FontWeight="Bold"/>
                                <DataGridTextColumn Header="Ghi chú"
                                                    Binding="{Binding Note}"
                                                    Width="120"
                                                    FontStyle="Italic"
                                                    Foreground="Gray"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Grid.Row="2"
                                    Orientation="Vertical"
                                    HorizontalAlignment="Right"
                                    Margin="0,15,0,0">
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right">
                                <TextBlock Text="TẠM TÍNH:"
                                           FontWeight="Bold"
                                           FontSize="14"
                                           VerticalAlignment="Center"/>
                                <TextBlock x:Name="lblPopupSubTotal"
                                           Text="0đ"
                                           FontWeight="Bold"
                                           FontSize="14"
                                           Foreground="#333"
                                           Margin="8,0,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        Margin="0,4,0,0">
                                <TextBlock Text="GIẢM BILL:"
                                           FontWeight="Bold"
                                           FontSize="14"
                                           VerticalAlignment="Center"/>
                                <TextBlock x:Name="lblPopupDiscount"
                                           Text="0đ"
                                           FontWeight="Bold"
                                           FontSize="14"
                                           Foreground="#C0392B"
                                           Margin="8,0,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        Margin="0,6,0,0">
                                <TextBlock Text="TỔNG CỘNG:"
                                           FontWeight="Bold"
                                           FontSize="16"
                                           VerticalAlignment="Center"/>
                                <TextBlock x:Name="lblPopupTotal"
                                           Text="0đ"
                                           FontWeight="Bold"
                                           FontSize="20"
                                           Foreground="#28A745"
                                           Margin="10,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

        </Grid>
    </Border>
</Window>